[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = MinimalHiiDxe
  FILE_GUID                      = 6a1e8c4d-3f7b-4a92-9d1e-8c5f2a1b6c50
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = MinimalHiiDxeEntry

[Sources]
  MinimalHiiDxe.c
  MinimalHiiStrings.uni

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  HiiLib
  DebugLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Depex]
  gEfiHiiDatabaseProtocolGuid AND gEfiHiiConfigRoutingProtocolGuid
