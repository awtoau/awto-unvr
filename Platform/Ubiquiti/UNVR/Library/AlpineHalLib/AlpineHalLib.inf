## @file
#  Annapurna Labs HAL (eth + UDMA + IOFIC) compiled as an EDK2 BASE library.
#
#  - Sources are STAGED from modules/al_eth/ by scripts/stage_hal.py into
#    al_hal_shared/ - a build artifact, gitignored, rewritten every build.
#    modules/al_eth is the single source (#256); EDK2 keeps no copy.
#  - Staged inside the package because an EDK2 INF cannot name sources outside
#    its own package directory.
#  - al_hal_plat_types.h / al_hal_plat_services.h in this dir are the UEFI
#    porting layer, force-included ahead of everything via -include; the
#    contract they satisfy is al_hal_shared/al_hal_plat_contract.h.
#  - $(MODULE_DIR) is used for -I because this repo sits on PACKAGES_PATH, not
#    under WORKSPACE (scripts/build-uefi-p0.py), so $(WORKSPACE)/... would not
#    resolve.
#
#  Copyright (c) 2026, Awto / Daniel Tyrrell. All rights reserved.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#
##

[Defines]
  INF_VERSION                    = 0x0001001b
  BASE_NAME                      = AlpineHalLib
  FILE_GUID                      = 898fcaf2-a7e4-40c1-8ce8-be17fc6e0fd0
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = AlpineHalLib

[Sources]
  # The five shared HAL objects, staged from modules/al_eth/. The MAC/EPE/
  # FIELD/RFW dispatch layer the old vendored copy compiled is not here: the
  # SNP driver never reached it (#256 phase 3).
  al_hal_shared/al_hal_eth_main.c
  al_hal_shared/al_hal_udma_main.c
  al_hal_shared/al_hal_udma_config.c
  al_hal_shared/al_hal_udma_iofic.c
  al_hal_shared/al_hal_iofic.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  IoLib
  PrintLib
  TimerLib

[BuildOptions]
  # -Wno-*: vendor C, not our style to fix; suppress rather than patch the HAL.
  GCC:*_*_*_CC_FLAGS = -I$(MODULE_DIR) -I$(MODULE_DIR)/al_hal_shared -include al_hal_plat_types.h -include al_hal_plat_services.h -Wno-unused-parameter -Wno-sign-compare -Wno-unused-variable -Wno-unused-function -Wno-unused-but-set-variable -Wno-maybe-uninitialized -Wno-parentheses -Wno-missing-braces -Wno-type-limits
