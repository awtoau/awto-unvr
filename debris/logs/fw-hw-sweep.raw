########## usr/bin/unifi-protect-db-cluster-migrate
  [raw_dev]
      if [ "$(pg_conftool -s 14 protect show data_directory 2>/dev/null)" = $EXTERNAL_DB_DATADIR ]; then
      pg_isready -p $PG_CLUSTER_PORT -q 2>/dev/null || return 0
      running_dir="$(su postgres -c "psql -p $PG_CLUSTER_PORT -tAc 'SHOW data_directory'" 2>/dev/null | tr -d '[:space:]')"

