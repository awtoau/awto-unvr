{
  // Native VS Code tasks. Two ways to run each:
  //   1. Ctrl+Shift+P -> "Tasks: Run Task" -> pick one (manual).
  //   2. Ignition MCP (jostrand.ignition-mcp) exposes each as an agent tool
  //      task_<label>, so Claude Code can invoke it directly.
  //
  // Interactive/long-running tasks (ssh, serial console) set
  //   isBackground + options.mcp.interactive so they open in a NATIVE terminal
  //   you can watch and type in, and the agent tool returns immediately instead
  //   of blocking on a session that never exits.
  //
  // woomera console model: ONE `tio` owns the serial line and serves a unix
  // socket ($XDG_RUNTIME_DIR/tio-unvr.sock); every console script attaches to it.
  //   - "serial console (tio)"    = start the owner; watch/type here.
  //   - "serial console (attach)" = a 2nd read/write view onto the same socket.
  //   - "ssh"                     = login over LAN (resolved by MAC, lease moves).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "woomera: ssh",
      "type": "shell",
      "command": "python3 scripts/ssh-woomera.py",
      "isBackground": true,
      "options": { "cwd": "${workspaceFolder}", "mcp": { "interactive": true } },
      "presentation": { "panel": "dedicated", "focus": true, "clear": true },
      "problemMatcher": []
    },
    {
      // Owns ttyS0 @115200 (console=ttyS0,115200) and serves tio-unvr.sock.
      // Quit tio with Ctrl-t q. Raw log -> tmp/logs/tio-woomera.log.
      "label": "woomera: serial console (tio)",
      "type": "shell",
      "command": "tio /dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0 -b 115200 -S unix:${env:XDG_RUNTIME_DIR}/tio-unvr.sock -L --log-file ${workspaceFolder}/tmp/logs/tio-woomera.log --log-append --log-strip",
      "isBackground": true,
      "options": { "cwd": "${workspaceFolder}", "mcp": { "interactive": true } },
      "presentation": { "panel": "dedicated", "focus": true, "clear": true },
      "problemMatcher": []
    },
    {
      // 2nd read/write view onto the running tio socket (requires the tio task
      // above to be running). Detach with Ctrl-] . Does NOT open a 2nd tio.
      "label": "woomera: serial console (attach)",
      "type": "shell",
      "command": "socat -,raw,echo=0,escape=0x1d UNIX-CONNECT:${env:XDG_RUNTIME_DIR}/tio-unvr.sock",
      "isBackground": true,
      "options": { "cwd": "${workspaceFolder}", "mcp": { "interactive": true } },
      "presentation": { "panel": "dedicated", "focus": true, "clear": true },
      "problemMatcher": []
    },
    {
      // One-shot: prints woomera's current DHCP address (by MAC OUI). Foreground
      // so the address is captured as the tool result.
      "label": "woomera: find on LAN",
      "type": "shell",
      "command": "python3 scripts/find-woomera-ssh.py",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "panel": "dedicated", "focus": true, "clear": true },
      "problemMatcher": []
    },
    {
      "label": "serial: loopback (continuous)",
      "type": "shell",
      "command": "python3 scripts/serial_loopback_test.py --repeat --interval 1.0",
      "isBackground": true,
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "panel": "dedicated", "focus": true, "clear": true },
      "problemMatcher": []
    },
    {
      "label": "serial: pin probe (one-shot)",
      "type": "shell",
      "command": "python3 scripts/serial_pin_probe.py",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "panel": "dedicated", "focus": true, "clear": true },
      "problemMatcher": []
    },
    {
      "label": "serial: baud sweep",
      "type": "shell",
      "command": "python3 scripts/serial_baud_sweep.py",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "panel": "dedicated", "focus": true, "clear": true },
      "problemMatcher": []
    }
  ]
}
