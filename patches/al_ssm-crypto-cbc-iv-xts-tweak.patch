 			skcipher_request_complete(rctx->req, 0);
 		} else if (rc == -EINPROGRESS) {
@@ -481,9 +504,8 @@ static int al_ssm_enqueue(struct al_ssm_ctx *ctx, struct skcipher_request *req,
 	rc = al_ssm_submit_and_poll(rctx);
 
 	if (rc == 0) {
