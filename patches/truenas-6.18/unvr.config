# UNVR board requirements merged over TrueNAS arm64 production (#338).
# Every line is FATAL-checked after olddefconfig (build-linux-truenas.py).
# Values match TrueNAS's where it already enables a symbol; =m relies on TrueNAS's initramfs.
# SoC + internal PCIe (ARCH_ALPINE selects ALPINE_MSI and NET_DEVLINK)
CONFIG_ARCH_ALPINE=y
CONFIG_PCIE_AL=y
CONFIG_PCIE_AL_INTERNAL=y
CONFIG_NET_DEVLINK=y
# SATA: per-port MSI-X driver (#92)
CONFIG_AHCI_ALPINE=m
# console + low-speed buses
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PLATFORM=m
CONFIG_I2C_MUX_PCA954x=m
CONFIG_GPIO_PL061=y
CONFIG_GPIO_PCA953X=y
CONFIG_GPIO_PCA953X_IRQ=y
CONFIG_SPI_DESIGNWARE=m
CONFIG_SPI_DW_MMIO=m
# board devices (DTS compatibles)
CONFIG_EEPROM_AT24=m
CONFIG_SENSORS_ADT7475=m
CONFIG_RTC_DRV_S35390A=m
CONFIG_ARM_SP805_WATCHDOG=m
CONFIG_EDAC_AL_MC=m
CONFIG_LEDS_GPIO=m
CONFIG_KEYBOARD_GPIO=m
CONFIG_REGULATOR_FIXED_VOLTAGE=m
CONFIG_PSTORE_RAM=m
# NOR (4K erase: config partitions are 4K-aligned) + raw NAND core for al_nand (#208)
CONFIG_MTD_SPI_NOR=m
CONFIG_MTD_SPI_NOR_USE_4K_SECTORS=y
CONFIG_MTD_OF_PARTS=m
CONFIG_MTD_RAW_NAND=m
# al_eth: 10G SFP+ via phylink (#113), AQR105 PHY
CONFIG_PHYLINK=m
CONFIG_SFP=m
CONFIG_MDIO_I2C=m
CONFIG_PCS_XPCS=m
CONFIG_AQUANTIA_PHY=m
# al_dma completion test (#23)
CONFIG_DMATEST=m
