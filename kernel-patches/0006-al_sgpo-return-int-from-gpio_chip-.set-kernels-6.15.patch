From c0464fb6a3e10032be8a34eb4e2bbb3cdafd0efc Mon Sep 17 00:00:00 2001
From: Dan on Selwyn <dan@awto.au>
Date: Sun, 16 Aug 2026 17:41:44 +1000
Subject: [PATCH] al_sgpo: return int from gpio_chip .set (kernels >= 6.15)

- gpio_chip.set (and set_multiple) return int since 6.15; gcc-14+ makes
  the void mismatch a hard -Werror=incompatible-pointer-types error.
- al_sgpo_set: return -EINVAL on out-of-range group, 0 on success.
- Out-of-tree module from github.com/bcyangkmluohmars/linux-alpine-v2;
  apply to that source when building against >= 6.15 (6.18 / 7.1). The
  6.12 build (gcc-12) tolerates the void form and needs no patch.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 modules/al_sgpo/al_sgpo.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/modules/al_sgpo/al_sgpo.c b/modules/al_sgpo/al_sgpo.c
index 8dff2dc..dfc44c1 100644
--- a/modules/al_sgpo/al_sgpo.c
+++ b/modules/al_sgpo/al_sgpo.c
@@ -178,7 +178,7 @@ static int al_sgpo_direction_output(struct gpio_chip *gc, unsigned int offset,
 	return 0;
 }
 
-static void al_sgpo_set(struct gpio_chip *gc, unsigned int offset, int value)
+static int al_sgpo_set(struct gpio_chip *gc, unsigned int offset, int value)
 {
 	struct al_sgpo *sgpo = gpiochip_get_data(gc);
 	unsigned int group = offset / AL_SGPO_PINS_PER_GROUP;
@@ -186,7 +186,7 @@ static void al_sgpo_set(struct gpio_chip *gc, unsigned int offset, int value)
 	unsigned long flags;
 
 	if (group >= sgpo->num_groups)
-		return;
+		return -EINVAL;
 
 	spin_lock_irqsave(&sgpo->lock, flags);
 
@@ -194,6 +194,8 @@ static void al_sgpo_set(struct gpio_chip *gc, unsigned int offset, int value)
 	       al_sgpo_group_reg(sgpo, group, GRP_VEC(1 << bit)));
 
 	spin_unlock_irqrestore(&sgpo->lock, flags);
+
+	return 0;
 }
 
 static int al_sgpo_get(struct gpio_chip *gc, unsigned int offset)
