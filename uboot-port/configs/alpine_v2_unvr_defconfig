CONFIG_ARM=y
CONFIG_TARGET_ALPINE_V2_UNVR=y
CONFIG_TEXT_BASE=0x01100000
CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x05000000
CONFIG_SYS_MALLOC_LEN=0x400000
CONFIG_NR_DRAM_BANKS=2
CONFIG_ENV_SIZE=0x10000
CONFIG_DEFAULT_DEVICE_TREE="alpine-v2-unvr-uboot"
CONFIG_SYS_LOAD_ADDR=0x02000000
CONFIG_BOOTDELAY=2
CONFIG_OF_CONTROL=y
CONFIG_DM=y
CONFIG_DM_SERIAL=y
CONFIG_SYS_NS16550=y
CONFIG_GIC_V3=y
CONFIG_NO_NET=y
# CONFIG_TOOLS_LIBCRYPTO is not set
# CONFIG_TOOLS_KWBIMAGE is not set
# CONFIG_FIT_SIGNATURE is not set
# CONFIG_DISPLAY_CPUINFO is not set
CONFIG_SYS_PROMPT="unvr# "
CONFIG_CMD_CACHE=y
CONFIG_CMD_MEMORY=y
# md/mw/mm let us read+poke the DDR controller (0xf0080000) / PHY (0xf0088000)
# regs live — DDR config inspection + manual timing experiments in chainload.
CONFIG_CMD_MEMTEST=y
CONFIG_SYS_ALT_MEMTEST=y
# Default memtest window well above U-Boot (TEXT 0x01100000, SP 0x05000000);
# runtime `mtest <start> <end>` overrides for any bank incl. 0x2_00000000.
CONFIG_SYS_MEMTEST_START=0x10000000
CONFIG_SYS_MEMTEST_END=0x40000000
# --- SATA/SSD boot: self-enumerate the internal PCIe (ECAM @0xfbc00000),
# assign BARs ourselves, bind class-based AHCI-PCI, mount ext4. Assume nothing
# from stock U-Boot. Mainline AHCI issues the SSS/SUD spin-up stock U-Boot omits.
CONFIG_PCI=y
CONFIG_PCIE_ECAM_GENERIC=y
CONFIG_CMD_PCI=y
CONFIG_BLK=y
CONFIG_SCSI=y
CONFIG_AHCI=y
CONFIG_SCSI_AHCI=y
CONFIG_AHCI_PCI=y
CONFIG_CMD_SCSI=y
CONFIG_PARTITIONS=y
CONFIG_EFI_PARTITION=y
CONFIG_DOS_PARTITION=y
CONFIG_FS_EXT4=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FS_GENERIC=y
# --- I2C + GPIO: power the SATA bays (PCA9575 @0x21 hog) before AHCI scan ---
CONFIG_CLK=y
CONFIG_DM_I2C=y
CONFIG_SYS_I2C_DW=y
CONFIG_CMD_I2C=y
CONFIG_DM_GPIO=y
CONFIG_DM_PCA953X=y
CONFIG_CMD_GPIO=y
CONFIG_GPIO_HOG=y
