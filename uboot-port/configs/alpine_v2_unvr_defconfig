CONFIG_ARM=y
CONFIG_TARGET_ALPINE_V2_UNVR=y
CONFIG_TEXT_BASE=0x01100000
CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x05000000
CONFIG_SYS_MALLOC_LEN=0x400000
CONFIG_NR_DRAM_BANKS=2
CONFIG_ENV_SIZE=0x10000
CONFIG_DEFAULT_DEVICE_TREE="awto-alpine-v2-unvr-uboot"
CONFIG_SYS_LOAD_ADDR=0x02000000
# -1 = never autoboot: our U-Boot always stops at its prompt on start ("stop on
# reset"). Prevents auto-running bootcmd (which can hang on a bad bootm before we
# have OF_LIBFDT + a working sysreset). Boot on demand with `run bootcmd` / `boot`.
CONFIG_BOOTDELAY=-1
CONFIG_BOARD_LATE_INIT=y
CONFIG_USE_PREBOOT=y
# Solid-on, NOT blink: the software blink is CYCLIC and re-writes the pca9575
# expanders (@0x20/@0x21) forever. If the i2c bus wedges (e.g. the s35390a on
# mux ch0 — docs/i2c-map.md), every blink cycle fails and FLOODS the console.
# Panel LEDs still light; blink stays available as a manual `led <l> blink` cmd.
CONFIG_PREBOOT="led d1 on; led d2 on; led d3 on; led d4 on; led white on; led blue on; led sfp on"
CONFIG_HUSH_PARSER=y
# Kernel cmdline — bootm fixes this into the DTB's /chosen/bootargs. Matches the
# live /proc/cmdline (rootfs on SSD sda2 by PARTUUID). Without it: no root -> panic.
CONFIG_USE_BOOTARGS=y
CONFIG_BOOTARGS="console=ttyS0,115200 root=PARTUUID=dcdc291e-9956-48cd-9d7c-48219877881a rootfstype=ext4 rw rootwait selinux=0 panic=15 reboot=cold ahci.mask_port_map=0x5"
# Canary in OUR U-Boot (chainloaded, so a bad bootcmd can't crash-loop the box).
# 0x10000000 is 16-aligned so itest.l is alignment-safe; survives warm reset
# (DRAM persists). Set it (mw 0x10000000 0xb0075709) to stay at our prompt on the
# next boot instead of booting off the SSD.
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="if itest.l *0x10000000 == 0xb0075709; then echo == CANARY set - staying in U-Boot ==; else scsi scan; ext4load scsi 0:2 0x02000000 /boot/uImage-unvr-ea16-7.1-fedora-gz && ext4load scsi 0:2 0x04078000 /boot/alpine-v2-ubnt-unvr-ea16-7.1-fedora.dtb && bootm 0x02000000 - 0x04078000; fi"
CONFIG_OF_CONTROL=y
CONFIG_DM=y
CONFIG_DM_SERIAL=y
CONFIG_SYS_NS16550=y
CONFIG_GIC_V3=y
# --- Networking: al_eth 1G RJ45 (RGMII), ping/tftp/dhcp. PCI-bound (1c36:0001),
# real MAC/UDMA/EC regs at the PCI BARs off 0xfe000000 — NOT the unused fc-range
# platform node. DM_ETH driver + curated Annapurna HAL subset (drivers/net/al_eth).
# RGMII only
# (no serdes) — 10G SFP+ (eth2) intentionally excluded. #83.
CONFIG_NET=y
CONFIG_DM_ETH=y
CONFIG_AL_ETH=y
CONFIG_AL_ETH_10G=y
CONFIG_AL_SSM=y
# VERBOSE logging at level 7 (LOGL_DEBUG) - full DM-bind/ofnode/driver-debug
# trace. Deliberately NOT level 8 (LOGL_DEBUG_CONTENT): level 8 is where
# designware_spi.c does log_content("tx/rx=..") PER BYTE, which (a) floods and
# (b) stalls the SPI reader until the 64KB env read OVERRUNS the Rx FIFO ->
# spi_flash_read() fails -> default env. That's a real dw_spi fragility (its
# overflow guard assumes a fast consumer). Cap at 7 to keep verbose safe.
# Per-driver al_dbg->debug() (eth/serdes) is separate, via -DDEBUG in Makefiles.
CONFIG_LOG=y
CONFIG_LOGLEVEL=7
CONFIG_LOG_MAX_LEVEL=7
CONFIG_LOG_DEFAULT_LEVEL=7
CONFIG_PHYLIB=y
CONFIG_PHY_ATHEROS=y
CONFIG_CMD_NET=y
CONFIG_CMD_PING=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_MII=y
# CONFIG_TOOLS_LIBCRYPTO is not set
# CONFIG_TOOLS_KWBIMAGE is not set
# CONFIG_FIT_SIGNATURE is not set
# CONFIG_DISPLAY_CPUINFO is not set
CONFIG_SYS_PROMPT="awto-nas# "
CONFIG_CMD_CACHE=y
CONFIG_CMD_MEMORY=y
# md/mw/mm let us read+poke the DDR controller (0xf0080000) / PHY (0xf0088000)
# regs live — DDR config inspection + manual timing experiments in chainload.
CONFIG_CMD_MEMTEST=y
CONFIG_SYS_ALT_MEMTEST=y
# Default memtest window well above U-Boot (TEXT 0x01100000, SP 0x05000000);
# runtime `mtest <start> <end>` overrides for any bank incl. 0x2_00000000.
CONFIG_SYS_MEMTEST_START=0x10000000
CONFIG_SYS_MEMTEST_END=0x40000000
# --- SATA/SSD boot: self-enumerate the internal PCIe (ECAM @0xfbc00000),
# assign BARs ourselves, bind class-based AHCI-PCI, mount ext4. Assume nothing
# from stock U-Boot. Mainline AHCI issues the SSS/SUD spin-up stock U-Boot omits.
CONFIG_PCI=y
CONFIG_PCIE_ECAM_GENERIC=y
CONFIG_CMD_PCI=y
CONFIG_BLK=y
CONFIG_SCSI=y
CONFIG_AHCI=y
CONFIG_SCSI_AHCI=y
CONFIG_AHCI_PCI=y
CONFIG_CMD_SCSI=y
CONFIG_PARTITIONS=y
CONFIG_EFI_PARTITION=y
CONFIG_DOS_PARTITION=y
CONFIG_FS_EXT4=y
CONFIG_EXT4_WRITE=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FS_GENERIC=y
# FAT (EFI System Partition) + GPT/partition tooling
CONFIG_FS_FAT=y
CONFIG_FAT_WRITE=y
CONFIG_CMD_FAT=y
CONFIG_CMD_GPT=y
CONFIG_CMD_PART=y
CONFIG_PARTITION_UUIDS=y
CONFIG_CMD_FS_UUID=y
CONFIG_CMD_UUID=y
CONFIG_LIB_UUID=y
# benchmarking + data-integrity (proves DMA reads: checksum a large read)
CONFIG_CMD_TIME=y
CONFIG_CMD_CRC32=y
CONFIG_CMD_MD5SUM=y
CONFIG_MD5=y
CONFIG_CMD_SHA1SUM=y
CONFIG_SHA1=y
CONFIG_CMD_MEMINFO=y
CONFIG_CMD_UNZIP=y
# distro / EFI / extlinux boot paths (Fedora BLS + grub)
CONFIG_EFI_LOADER=y
CONFIG_CMD_BOOTEFI=y
CONFIG_BOOTSTD=y
CONFIG_BOOTSTD_FULL=y
CONFIG_BOOTMETH_DISTRO=y
CONFIG_BOOTMETH_EXTLINUX=y
CONFIG_BOOTMETH_EFI=y
CONFIG_CMD_PXE=y
CONFIG_CMD_SYSBOOT=y
CONFIG_CMD_BOOTMENU=y
CONFIG_MENU=y
# boot the gzip uImage off the SSD: bootm + legacy image + gzip; decompress
# buffer must exceed the ~57 MB uncompressed arm64 Image (64 MB here).
CONFIG_CMD_BOOTM=y
CONFIG_CMD_BOOTI=y
CONFIG_LEGACY_IMAGE_FORMAT=y
CONFIG_GZIP=y
CONFIG_SYS_BOOTM_LEN=0x4000000
# --- I2C + GPIO: power the SATA bays (PCA9575 @0x21 hog) before AHCI scan ---
CONFIG_CLK=y
CONFIG_DM_I2C=y
CONFIG_SYS_I2C_DW=y
CONFIG_CMD_I2C=y
# PCA9546 mux (@0x71) as real child buses: `i2c bus` enumerates ch0-ch3 and
# each is probeable via `i2c dev <n>; i2c probe`. Without this the mux is a bare
# 0x71 device and behind-mux chips (RTC/SFP/adt7475) need manual register pokes.
# Driver from mainline (drivers/i2c/muxes/pca954x.c).
CONFIG_I2C_MUX=y
CONFIG_I2C_MUX_PCA954x=y
CONFIG_DM_GPIO=y
CONFIG_DM_PCA953X=y
CONFIG_CMD_GPIO=y
CONFIG_GPIO_HOG=y
# named LEDs via the `led` command (pca9575-backed: SFP + bay faults)
CONFIG_LED=y
CONFIG_LED_GPIO=y
CONFIG_CMD_LED=y
CONFIG_LED_BLINK=y
CONFIG_LED_SW_BLINK=y
CONFIG_CYCLIC=y
# diagnostics (were the 4 "Unknown command" gaps)
CONFIG_CMD_DM=y
CONFIG_CMD_CLK=y
CONFIG_CMD_PART=y
CONFIG_CMD_MMC=y
# --- 10G SFP+ SerDes/PCS (drivers/phy/al_serdes, #83 later:10G)
CONFIG_AL_SERDES=y
# --- SPI-NOR (MX25U25635F @ dw-apb-ssi 0xfd882000): persistent env + per-unit MAC
# DesignWare APB SSI master + mainline spi-nor. Gives raw NOR access for our env
# (Factory partition mtd3 @0x1e0000, unused by stock) and the MAC (EEPROM mtd4
# @0x1f0000, read via al_eth read_rom_hwaddr). docs/mtd.md.
CONFIG_DM_SPI=y
CONFIG_DESIGNWARE_SPI=y
CONFIG_SPI=y
# MTD gates the whole "SPI Flash Support" Kconfig menu (drivers/mtd/Kconfig
# `if MTD`) - without it SPI_FLASH/DM_SPI_FLASH/CMD_SF/ENV_IS_IN_SPI_FLASH all
# silently drop.
CONFIG_MTD=y
CONFIG_SPI_FLASH=y
CONFIG_DM_SPI_FLASH=y
CONFIG_SPI_FLASH_MACRONIX=y
CONFIG_SPI_FLASH_SFDP_SUPPORT=y
CONFIG_CMD_SF=y
CONFIG_SF_DEFAULT_SPEED=37500000
CONFIG_SF_DEFAULT_MODE=0x0
# env in the Factory partition (mtd3): 64KB @0x1e0000, 4KB erase sectors. Replaces
# ENV_IS_NOWHERE -> setenv/saveenv now persist across reset (#81). Own store, NOT
# stock's mtd1/mtd2, so our boot flow never inherits stock bootcmd/bootargs.
CONFIG_ENV_IS_IN_SPI_FLASH=y
CONFIG_ENV_OFFSET=0x1E0000
CONFIG_ENV_SECT_SIZE=0x1000
CONFIG_ENV_SPI_BUS=0
CONFIG_ENV_SPI_CS=0
CONFIG_ENV_SPI_MAX_HZ=37500000
CONFIG_ENV_SPI_MODE=0x0
CONFIG_CMD_SAVEENV=y
