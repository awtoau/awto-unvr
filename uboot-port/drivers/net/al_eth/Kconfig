config AL_ETH
	bool "Annapurna Labs al_eth 1G RGMII (Alpine V2 / AL-324) Ethernet"
	depends on DM_ETH
	select PHYLIB
	help
	  DM_ETH driver for the Alpine V2 integrated 1G Ethernet MAC in RGMII
	  mode (UNVR eth1 @ 0xfc100000, PCI 1c36:0001, AR8033 PHY on MDIO addr 4).
	  MAC + UDMA + clause-22 MDIO only; no serdes/KR/PCS (10G SFP+ excluded).
	  Bundles a curated subset of the Annapurna Labs HAL under hal/.
