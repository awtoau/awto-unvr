config AL_ETH
	bool "Annapurna Labs al_eth 1G RGMII (Alpine V2 / AL-324) Ethernet"
	depends on DM_ETH
	select PHYLIB
	help
	  DM_ETH driver for the Alpine V2 integrated 1G Ethernet MAC in RGMII
	  mode (UNVR eth1 @ 0xfc100000, PCI 1c36:0001, AR8033 PHY on MDIO addr 4).
	  MAC + UDMA + clause-22 MDIO only; no serdes/KR/PCS (10G SFP+ excluded).
	  Bundles a curated subset of the Annapurna Labs HAL under hal/.

config AL_ETH_DEBUG
	bool "al_eth + al_serdes verbose HAL trace (-DDEBUG)"
	depends on AL_ETH
	help
	  Compile the al_eth and al_serdes directories with -DDEBUG, which turns
	  every HAL al_dbg() and driver debug()/dev_dbg() into a console print:
	  the full UDMA descriptor-fetch and adapter bring-up trace, plus every
	  SerDes PMA register access. Thousands of lines per boot.

	  Off by default. `eth diag` answers the usual "why is this port down"
	  question on demand; turn this on only to trace a bring-up live - e.g.
	  the last register logged before an SError names the faulting access.

config AL_ETH_10G
	bool "Annapurna Labs al_eth 10G SFP+ (eth2, 1c36:0002) - DRAFT"
	depends on AL_ETH
	select AL_SERDES
	help
	  DM_ETH driver for the Alpine V2 10G SFP+ port (UNVR eth2, PCI 1c36:0002)
	  in AL_ETH_MAC_MODE_10GbE_Serial (fixed 10.3125 Gbps, KR AN/LT off). Reuses
	  the same UDMA/EC datapath as AL_ETH; adds the SerDes lane + 10GBASE-R PCS
	  front-end (via CONFIG_AL_SERDES) and no-PHY PCS-block-lock link. No new HAL
	  objects (10GbE_Serial is served by the already-compiled mac_v1_v2).

	  DRAFT / compile-only: needs on-box iteration AND the shared UDMA TX fix
	  before it passes traffic. See docs/eth-10g-plan.md.
