// SPDX-License-Identifier: GPL-2.0+ OR X11
/*
 * Minimal U-Boot control DTS for the Ubiquiti UNVR
 * (Annapurna Labs Alpine V2 / AL-324, sysid 0xea16).
 *
 * Stage-1 console bring-up only: CPUs, PSCI, GIC-v3, arch timer, UART0,
 * memory. Addresses from docs/hardware.md (verified against the live DT).
 * PCIe/SATA/SPI-NOR/I2C nodes are added in later stages.
 */

/dts-v1/;

/ {
	model = "Ubiquiti UNVR (Annapurna Labs Alpine V2 AL-324)";
	compatible = "ubnt,unvr", "annapurna-labs,al-alpine-v2", "al,alpine-v2";
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		serial0 = &uart0;
		serial2 = &uart2;	/* RPS-connector UART — usable as a 2nd console */
	};

	chosen {
		stdout-path = "serial0:1500000n8";
	};

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a57";
			reg = <0x0 0x0>;
			enable-method = "psci";
		};
		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a57";
			reg = <0x0 0x1>;
			enable-method = "psci";
		};
		cpu2: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a57";
			reg = <0x0 0x2>;
			enable-method = "psci";
		};
		cpu3: cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a57";
			reg = <0x0 0x3>;
			enable-method = "psci";
		};
	};

	psci {
		compatible = "arm,psci-0.2", "arm,psci";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		/* GIC_PPI type; LEVEL_LOW(8) per the vendor dtsi */
		interrupts = <1 13 8>, <1 14 8>, <1 11 8>, <1 10 8>;
	};

	/* 4 GiB: 3 GiB contiguous at 0 + 1 GiB above 4 GiB (docs/hardware.md) */
	memory@0 {
		device_type = "memory";
		reg = <0x0 0x00000000 0x0 0xC0000000>,
		      <0x2 0x00000000 0x0 0x40000000>;
	};

	/* System-bus clock (500 MHz) — feeds the DW I2C IP so its 100 kHz
	 * dividers are computed against the real rate, not the 166 MHz fallback. */
	sbclk: sbclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <500000000>;
	};


	gic: interrupt-controller@f0200000 {
		compatible = "arm,gic-v3";
		#interrupt-cells = <3>;
		#address-cells = <2>;
		#size-cells = <2>;
		interrupt-controller;
		reg = <0x0 0xf0200000 0x0 0x10000>,	/* GICD */
		      <0x0 0xf0280000 0x0 0x200000>;	/* GICR */
		interrupts = <1 9 4>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		uart0: serial@fd883000 {
			compatible = "ns16550a";
			reg = <0x0 0xfd883000 0x0 0x1000>;
			interrupts = <0 17 4>;		/* GIC_SPI 17 LEVEL_HIGH */
			clock-frequency = <500000000>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "okay";
		};

		/*
		 * uart2 = the RPS-connector UART (ttyS2), RS-232 via MAX3221 (U122)
		 * out on JB4. Enabled as serial2 so it can serve as a SECOND console
		 * (`setenv stdout serial2; setenv stdin serial2`) — a spare RS-232
		 * console when RPS is unused. See docs/rps-subsystem.md,
		 * docs/uboot-hw-test-suite.md. RPS itself runs 115200 8N1 JSON.
		 */
		uart2: serial@fd885000 {
			compatible = "ns16550a";
			reg = <0x0 0xfd885000 0x0 0x1000>;
			interrupts = <0 19 4>;		/* GIC_SPI 19 LEVEL_HIGH */
			clock-frequency = <500000000>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "okay";
		};

		/*
		 * DesignWare APB SSI SPI master @0xfd882000 -> the MX25U25635F SPI-NOR
		 * (32 MB, spi0.0). Gives our U-Boot raw NOR access for TWO things:
		 *   - env in the Factory partition (mtd3, offset 0x1e0000) - unused by
		 *     stock (0xFF across all firmware), so no shared-partition hazard (#81).
		 *   - the per-unit MAC in the EEPROM partition (mtd4, offset 0x1f0000+0x0)
		 *     read via al_eth read_rom_hwaddr (#89).
		 * Clock = &sbclk (500 MHz, same as stock's SPI node). Flash JEDEC-probed.
		 * docs/mtd.md, docs/hw-reference/.../live.dts (compatible + 37.5 MHz max).
		 */
		spi0: spi@fd882000 {
			compatible = "snps,dw-apb-ssi";
			reg = <0x0 0xfd882000 0x0 0x1000>;
			#address-cells = <1>;
			#size-cells = <0>;
			num-cs = <4>;
			clocks = <&sbclk>;
			status = "okay";

			spi_nor: flash@0 {
				compatible = "jedec,spi-nor";
				reg = <0>;
				spi-max-frequency = <37500000>;	/* 0x23c3460, per stock DT */
			};
		};

		/*
		 * DDR memory controller (Alpine V2 / AL-324). Consumed by the `ddr`
		 * command (board/annapurna/alpine/al_ddr) which reads its three
		 * register bases by reg-name via ofnode — NEVER hardcoded (#84).
		 *   nb   = nb-service (rev/int)   0xf0070000
		 *   ctrl = uMCTL2 controller      0xf0080000
		 *   phy  = DWC PUB PHY            0xf0088000
		 * docs/hardware.md / docs/uboot-ddr-port.md §4.
		 */
		ddr: memory-controller@f0080000 {
			compatible = "annapurna-labs,al-ddr";
			reg = <0x0 0xf0070000 0x0 0x10000>,	/* nb-service */
			      <0x0 0xf0080000 0x0 0x8000>,	/* uMCTL2 ctrl */
			      <0x0 0xf0088000 0x0 0x8000>;	/* PUB PHY */
			reg-names = "nb", "ctrl", "phy";
			status = "okay";
		};

		/*
		 * 25G SerDes PMA (AL-324 / Alpine V2) — the SFP+ 10G port's PHY.
		 * Consumed by CONFIG_AL_SERDES (drivers/phy/al_serdes); the `serdes`
		 * command reads both bases by reg-name via ofnode, never hardcoded.
		 * docs/hardware.md: serdes PMA @ 0xfd8c0000 size 0x2400.
		 *
		 * "pcs" = the eth2 MAC-adapter window that also holds the 10GBASE-R
		 * PCS sub-block (0xfe120000/0x10000) — SHARED with the eth/MAC path;
		 * optional (absent -> PCS left to the MAC agent). HW: confirm the
		 * exact PCS base on the box and reconcile with the eth MAC datapath.
		 */
		serdes: serdes@fd8c0000 {
			compatible = "annapurna-labs,al-serdes-25g";
			reg = <0x0 0xfd8c0000 0x0 0x00002400>,	/* serdes PMA */
			      <0x0 0xfe120000 0x0 0x00010000>;	/* pcs (MAC adapter) */
			reg-names = "serdes", "pcs";
			status = "okay";
		};

		/*
		 * 1G Ethernet (eth1 / al_eth1, RJ45): NO platform node here. It is a
		 * PCI-enumerated endpoint on the internal PCIe (vendor 0x1c36 dev
		 * 0x0001, bus 0) — the al_eth DM driver binds by PCI ID and maps its
		 * three BARs (UDMA/EC/MAC), so the bare eth0..3 nodes at 0xfc000000+
		 * in the stock DT are unused (docs/hardware.md). RGMII, external
		 * AR8033 PHY on the internal MDIO bus at addr 4; the driver drives
		 * the PHY via phylib. DMA coherency: the #74 SMCC snoop fix.
		 */

		/*
		 * al_eth board params. Node names, property names and values are a
		 * VERBATIM copy of stock's own /soc/board-cfg/ethernet
		 * (tmp/uboot-dtbs/dtb00-0x081048-26358B.dts, sysid ea16), so the two
		 * are diffable and our parser mirrors stock's board.c 1:1.
		 *
		 * These are the ONLY source of the MAC scratchpad registers Linux's
		 * al_eth reads at probe; without them it fails with "board info not
		 * available" and there is no ethernet at all. Written per port by
		 * al_eth_bp_seed() (drivers/net/al_eth/al_eth_boardparams.c).
		 *
		 * Reproduced as stock has it, including the DAC/optic contradiction
		 * on port2 (dac + force-1000base-x on a port with an SR optic) —
		 * matching behaviour first, see #200. Stock's leds/ subnode is not
		 * carried: board-params reg 3 holds only gpio_spd_10g/25g, and this
		 * board defines neither (it has leds/sfp_1g only), so reg 3 is 0
		 * either way.
		 */
		board-cfg {
			ethernet {
				port1 {
					status = "enabled";
					mode = "rgmii";

					ext_phy {
						phy_mgmt_if = "mdc-mdio";
						phy-addr = <0x04>;
						mdc-mdio-freq = "1.0Mhz";
						auto-neg-mode = "out-of-band";
					};
				};

				port2 {
					status = "enabled";
					mode = "auto-detect-auto-speed";
					i2c-id = <0x02>;
					serdes-grp = <0x03>;
					serdes-lane = <0x00>;

					10g-serial {
						dac = "enabled";
						dac-length = <0x03>;
						auto-neg = "disabled";
						link-training = "disabled";
						fec = "disabled";
						force-1000base-x = "enabled";
					};

					retimer {
						exist = "disabled";
						type = "br410";
						i2c-bus = <0x01>;
						i2c-addr = <0x56>;
						channel = "B";
					};
				};
			};
		};

		/*
		 * Internal PCIe host — an ECAM-compatible window at 0xfbc00000
		 * fronting the SoC's integrated PCI endpoints (bus 0 only): 2×
		 * AHCI SATA (1c36:0031, class AHCI 1.0), eth, crypto, DMA. We use
		 * "pci-host-ecam-generic" (U-Boot's PCIE_ECAM_GENERIC binds it);
		 * Linux uses the vendor "annapurna-labs,alpine-internal-pcie" host
		 * driver instead — the ONLY delta is that driver does the AXI snoop
		 * coherency fixup (see the note below + issue #74). Endpoints bind by
		 * PCI ID regardless of the host compatible. We ENUMERATE OURSELVES +
		 * assign BARs — never rely on stock U-Boot (no standalone enumeration).
		 *   reg    = ECAM config space (1 MB, one 4 KB window per devfn)
		 *   ranges = 32-bit non-prefetch MMIO, PCI 0xfe000000 -> CPU 1:1, 16 MB
		 * MSI/interrupts omitted: U-Boot polls AHCI.
		 * Annapurna extra NOT here yet: AXI SMCC snoop (cfg 0x110-0x170) +
		 * APP_CONTROL (0x220) for cache-coherent DMA — add via a board hook
		 * if AHCI DMA reads come back incoherent. (pcie-al-internal.c ref.)
		 */

		pci@fbc00000 {
			compatible = "pci-host-ecam-generic";
			device_type = "pci";
			#address-cells = <3>;
			#size-cells = <2>;
			#interrupt-cells = <1>;
			reg = <0x0 0xfbc00000 0x0 0x100000>;
			ranges = <0x02000000 0x0 0xfe000000  0x0 0xfe000000  0x0 0x01000000>;
			bus-range = <0x00 0x00>;
		};

		/* External PCIe port 0 - xHCI USB 3.0 host (ASMedia), same link
		 * Linux's pcie_ext0 (dts/alpine-v2-ubnt-unvr-ea16.dts) uses via
		 * the amazon,al-alpine-v2-pcie driver - no U-Boot driver exists
		 * for that compatible, so this uses the generic ECAM driver
		 * instead. WIP (#137/#132/#140): the controller enumerates but
		 * `pci`/`pci enum` showed the SAME device at every devfn on the
		 * bus (01.00.00 through 01.1f.00, all identical).
		 *
		 * bus-range = <0x01 0x01> below (real assigned bus, since the
		 * internal pci@fbc00000 node already claims bus 0) was tested as
		 * a fix for a suspected reg-window/bus-offset mismatch -
		 * DISPROVEN on hardware, identical aliasing either way. Kept
		 * anyway since it's a more accurate description of the real
		 * topology (one bus, not 256), but the actual bug is elsewhere -
		 * most likely this controller genuinely isn't flat-ECAM (needs
		 * real per-access config-space windowing, which
		 * pci-host-ecam-generic doesn't provide) - see #140 for the next
		 * steps (compare against amazon,al-alpine-v2-pcie / the vendor
		 * decompiled binary for real windowing logic). device-context
		 * allocation may also still time out separately once enumeration
		 * is fixed - likely needs explicit SMCC snoop-enable register
		 * writes for this bus too (dma-coherent alone doesn't configure
		 * the hardware snoop bits, same class of thing the internal
		 * bus's al_pcie_internal_notifier does). Not yet fixed.
		 */
		pcie_ext0: pci@fb600000 {
			compatible = "pci-host-ecam-generic";
			device_type = "pci";
			dma-coherent;
			#address-cells = <3>;
			#size-cells = <2>;
			#interrupt-cells = <1>;
			reg = <0x0 0xfb600000 0x0 0x100000>;
			ranges = <0x02000000 0x0 0xc0010000  0x0 0xc0010000  0x0 0x07ff0000>;
			bus-range = <0x01 0x01>;
		};

		/* SoC GPIO (PL061), 6 banks × 8 = 48 lines. "arm,pl061" only (drop
		 * primecell -> no AMBA needed). gpio-line-names = the live MUIO
		 * pinmux map (read 2026-08-18, docs/gpio-map.md) so `gpio status`
		 * self-labels every ball: mux func 0=GPIO / nand / uart2(RPS) /
		 * sgpo / eth-led. "spare*" = GPIO-mode, no known consumer (SW1/SW2/
		 * strap candidates). NAND-bus lines named so they're not mistaken
		 * for free. */
		gpio0: gpio@fd887000 {
			compatible = "arm,pl061"; reg = <0x0 0xfd887000 0x0 0x1000>;
			gpio-controller; #gpio-cells = <2>;
			gpio-line-names = "sfp-25g-led", "spare1", "spare2", "spare3",
					  "spare4", "spare5", "nand-d0", "nand-d1";
		};
		gpio1: gpio@fd888000 {
			compatible = "arm,pl061"; reg = <0x0 0xfd888000 0x0 0x1000>;
			gpio-controller; #gpio-cells = <2>;
			gpio-line-names = "nand-d2", "nand-d3", "nand-d4", "nand-d5",
					  "nand-d6", "nand-d7", "nand-d8", "nand-d9";
		};
		gpio2: gpio@fd889000 {
			compatible = "arm,pl061"; reg = <0x0 0xfd889000 0x0 0x1000>;
			gpio-controller; #gpio-cells = <2>;
			gpio-line-names = "nand-d10", "nand-d11", "nand-d12", "nand-cs",
					  "spare20", "sgpo", "spare22", "spare23";
		};
		gpio5: gpio@fd897000 {
			compatible = "arm,pl061"; reg = <0x0 0xfd897000 0x0 0x1000>;
			gpio-controller; #gpio-cells = <2>;
			gpio-line-names = "spare40", "spare41", "hdd-force-pwr", "spare43",
					  "spare44", "spare45", "spare46", "spare47";
		};
		gpio3: gpio@fd88a000 {
			compatible = "arm,pl061";
			reg = <0x0 0xfd88a000 0x0 0x1000>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-line-names = "sgpo", "sgpo", "uart2-rps-rx", "uart2-rps-tx",
					  "spare28", "spare29", "eth-led", "ulogo-blue";
		};
		gpio4: gpio@fd88b000 {
			compatible = "arm,pl061";
			reg = <0x0 0xfd88b000 0x0 0x1000>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-line-names = "spare32", "rps-prnt", "12v-lp", "spare35",
					  "spare36", "ulogo-white", "reset-btn", "spare39";
		};

		/*
		 * I2C "i2c-pld" (DesignWare) @ fd880000, 100 kHz. Hosts the PCA9575
		 * GPIO expanders. We need @0x21 to POWER THE SATA BAYS before AHCI:
		 * on a warm reset the expander drops its outputs, so the drives are
		 * unpowered and every SATA link times out. Same hog the kernel DTS
		 * uses (bays 1-4 = lines 0-3, active-high). This is the "just power
		 * the drive" step — replicated from upstream, not invented.
		 */
		i2c@fd880000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0xfd880000 0x0 0x1000>;
			clocks = <&sbclk>;
			/* 100 kHz (Standard-mode) = stock's speed. NOT max-by-default:
			 * the s35390a RTC on mux ch0 mis-reads a phantom START/STOP at
			 * 400 kHz and holds SDA -> whole-bus wedge, unrecoverable in SW on
			 * this bus (no GPIO alt for a bit-bang deblock; DW v1.20 has no HW
			 * SDA-stuck recovery - docs/rtc-s35390a-fault.md). Stock ran 100 kHz
			 * and talked to the RTC fine. Tolerant devices don't care. */
			clock-frequency = <100000>;
			/* SDA hold time = the stock board value (live.dts:
			 * i2c-sda-hold-time-ns = 0x12c = 300 ns), which mainline dropped.
			 * Restored for parity with stock. Effect on the RTC: unverified. */
			i2c-sda-hold-time-ns = <300>;
			/* Stock's proven raw SCL counts (live.dts:249-254) so the
			 * s35390a doesn't wedge (docs/rtc-s35390a-fault.md). At
			 * clock-frequency=100000 the SS pair is used; fs/hs carried
			 * for completeness. Honored by our patched DW i2c driver. */
			i2c-ss-scl-hcnt-raw = <0x855>;
			i2c-ss-scl-lcnt-raw = <0xb0b>;
			i2c-fs-scl-hcnt-raw = <0x19d>;
			i2c-fs-scl-lcnt-raw = <0x320>;
			i2c-hs-scl-hcnt-raw = <0xf3>;
			i2c-hs-scl-lcnt-raw = <0x198>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			/* @0x20 — SFP+ 1G link LED on pin 2 (see LED map). */
			i2c_gpio0: gpio@20 {
				compatible = "nxp,pca9575";
				reg = <0x20>;
				gpio-controller;
				#gpio-cells = <2>;
			};

			i2c_gpio1: gpio@21 {
				compatible = "nxp,pca9575";
				reg = <0x21>;
				gpio-controller;
				#gpio-cells = <2>;

				/* One hog per line — U-Boot's gpio-hog only takes the
				 * FIRST gpio in a list, so a single node with 4 gpios
				 * powered only bay 1. Bays 1-4 = lines 0-3, active-high. */
				hdd-pwren0-hog { gpio-hog; gpios = <0 0>; output-high; line-name = "hdd-pwren0"; };
				hdd-pwren1-hog { gpio-hog; gpios = <1 0>; output-high; line-name = "hdd-pwren1"; };
				hdd-pwren2-hog { gpio-hog; gpios = <2 0>; output-high; line-name = "hdd-pwren2"; };
				hdd-pwren3-hog { gpio-hog; gpios = <3 0>; output-high; line-name = "hdd-pwren3"; };
			};

			/* DDR-config EEPROM @0x57 (AT24C64, 16-bit addr). Reads
			 * 0x1c36-repeating — the DDR bootstrap blob (issue #67), not
			 * plain SPD. Node lets `i2c md` use the right 2-byte offset. */
			eeprom@57 {
				compatible = "atmel,24c64";
				reg = <0x57>;
				pagesize = <32>;
			};

			/* PCA9546 i2c mux @0x71 as real child buses so `i2c bus` /
			 * `i2c dev <n>; i2c probe` scan each channel (needs I2C_MUX +
			 * I2C_MUX_PCA954x). ch0 -> s35390a RTC @0x30 + SFP EEPROM @0x50;
			 * ch3 -> adt7475 FAN CONTROLLER @0x2e; ch1/ch2 empty. The mux
			 * uclass deselects (writes 0x00) after every access, so a wedged
			 * ch0 can't hold the parent bus between transfers. Only touch ch0
			 * deliberately — the s35390a can still hold SDA mid-transfer. */
			i2c_mux: i2c-mux@71 {
				compatible = "nxp,pca9546";
				reg = <0x71>;
				#address-cells = <1>;
				#size-cells = <0>;

				i2c@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;

					rtc@30 {
						compatible = "sii,s35390a";
						reg = <0x30>;
					};
				};

				i2c@3 {
					reg = <3>;
					#address-cells = <1>;
					#size-cells = <0>;

					/* adt7475 PWM fan controller (temp/voltage + fan drive) */
					adt7475@2e {
						compatible = "adi,adt7475";
						reg = <0x2e>;
					};
				};
			};
		};

		/* Second DW i2c "i2c-gen" @0xfd894000. Carries the 2x RPS ORing power
		 * monitors (12V + 54V rails, U48-area — docs/i2c-map.md). A live probe
		 * reads EMPTY, but that is the PINMUX not absence: pins 30/31 aren't
		 * muxed to I2C_GEN (func2), so the controller can't drive the bus (#64).
		 * Enabled anyway for RE. clock via sbclk, same 400 kHz. */
		i2c@fd894000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0xfd894000 0x0 0x1000>;
			clocks = <&sbclk>;
			clock-frequency = <400000>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";
		};
	};

	/* Named LEDs -> the `led` command (led <label> on|off, led list). All
	 * default-on so a running our-U-Boot lights the panel. pca9575-backed only
	 * for now: SFP (@0x20 pin2) + bay1-4 fault (@0x21 lines12-15, orange).
	 * Logo (al_gpio) + bay activity (SGPO) LEDs need those driver ports. */
	leds {
		compatible = "gpio-leds";
		led-d1 { label = "d1"; gpios = <&i2c_gpio1 12 0>; default-state = "on"; };
		led-d2 { label = "d2"; gpios = <&i2c_gpio1 13 0>; default-state = "on"; };
		led-d3 { label = "d3"; gpios = <&i2c_gpio1 14 0>; default-state = "on"; };
		led-d4 { label = "d4"; gpios = <&i2c_gpio1 15 0>; default-state = "on"; };
		led-sfp { label = "sfp"; gpios = <&i2c_gpio0 2 1>; default-state = "on"; };
		led-white { label = "white"; gpios = <&gpio4 5 1>; default-state = "on"; };
		led-blue { label = "blue"; gpios = <&gpio3 7 1>; default-state = "on"; };
	};
};
