// SPDX-License-Identifier: GPL-2.0+ OR X11
/*
 * Minimal U-Boot control DTS for the Ubiquiti UNVR
 * (Annapurna Labs Alpine V2 / AL-324, sysid 0xea16).
 *
 * Stage-1 console bring-up only: CPUs, PSCI, GIC-v3, arch timer, UART0,
 * memory. Addresses from docs/hardware.md (verified against the live DT).
 * PCIe/SATA/SPI-NOR/I2C nodes are added in later stages.
 */

/dts-v1/;

/ {
	model = "Ubiquiti UNVR (Annapurna Labs Alpine V2 AL-324)";
	compatible = "ubnt,unvr", "annapurna-labs,al-alpine-v2", "al,alpine-v2";
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		serial0 = &uart0;
		serial2 = &uart2;	/* RPS-connector UART — usable as a 2nd console */
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a57";
			reg = <0x0 0x0>;
			enable-method = "psci";
		};
		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a57";
			reg = <0x0 0x1>;
			enable-method = "psci";
		};
		cpu2: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a57";
			reg = <0x0 0x2>;
			enable-method = "psci";
		};
		cpu3: cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a57";
			reg = <0x0 0x3>;
			enable-method = "psci";
		};
	};

	psci {
		compatible = "arm,psci-0.2", "arm,psci";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		/* GIC_PPI type; LEVEL_LOW(8) per the vendor dtsi */
		interrupts = <1 13 8>, <1 14 8>, <1 11 8>, <1 10 8>;
	};

	/* 4 GiB: 3 GiB contiguous at 0 + 1 GiB above 4 GiB (docs/hardware.md) */
	memory@0 {
		device_type = "memory";
		reg = <0x0 0x00000000 0x0 0xC0000000>,
		      <0x2 0x00000000 0x0 0x40000000>;
	};

	/* System-bus clock (500 MHz) — feeds the DW I2C IP so its 100 kHz
	 * dividers are computed against the real rate, not the 166 MHz fallback. */
	sbclk: sbclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <500000000>;
	};


	gic: interrupt-controller@f0200000 {
		compatible = "arm,gic-v3";
		#interrupt-cells = <3>;
		#address-cells = <2>;
		#size-cells = <2>;
		interrupt-controller;
		reg = <0x0 0xf0200000 0x0 0x10000>,	/* GICD */
		      <0x0 0xf0280000 0x0 0x200000>;	/* GICR */
		interrupts = <1 9 4>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		uart0: serial@fd883000 {
			compatible = "ns16550a";
			reg = <0x0 0xfd883000 0x0 0x1000>;
			interrupts = <0 17 4>;		/* GIC_SPI 17 LEVEL_HIGH */
			clock-frequency = <500000000>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "okay";
		};

		/*
		 * uart2 = the RPS-connector UART (ttyS2), RS-232 via MAX3221 (U122)
		 * out on JB4. Enabled as serial2 so it can serve as a SECOND console
		 * (`setenv stdout serial2; setenv stdin serial2`) — a spare RS-232
		 * console when RPS is unused. See docs/rps-subsystem.md,
		 * docs/uboot-hw-test-suite.md. RPS itself runs 115200 8N1 JSON.
		 */
		uart2: serial@fd885000 {
			compatible = "ns16550a";
			reg = <0x0 0xfd885000 0x0 0x1000>;
			interrupts = <0 19 4>;		/* GIC_SPI 19 LEVEL_HIGH */
			clock-frequency = <500000000>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "okay";
		};

		/*
		 * Internal PCIe host — an ECAM-compatible window at 0xfbc00000
		 * fronting the SoC's integrated PCI endpoints (bus 0 only): 2×
		 * AHCI SATA (1c36:0031, class AHCI 1.0), eth, crypto, DMA. Linux
		 * uses "pci-host-ecam-generic" here; U-Boot's PCIE_ECAM_GENERIC
		 * binds the same. We ENUMERATE OURSELVES + assign BARs — never
		 * rely on stock U-Boot's enumeration (it doesn't exist standalone).
		 *   reg    = ECAM config space (1 MB, one 4 KB window per devfn)
		 *   ranges = 32-bit non-prefetch MMIO, PCI 0xfe000000 -> CPU 1:1, 16 MB
		 * MSI/interrupts omitted: U-Boot polls AHCI.
		 * Annapurna extra NOT here yet: AXI SMCC snoop (cfg 0x110-0x170) +
		 * APP_CONTROL (0x220) for cache-coherent DMA — add via a board hook
		 * if AHCI DMA reads come back incoherent. (pcie-al-internal.c ref.)
		 */

		pci@fbc00000 {
			compatible = "pci-host-ecam-generic";
			device_type = "pci";
			#address-cells = <3>;
			#size-cells = <2>;
			#interrupt-cells = <1>;
			reg = <0x0 0xfbc00000 0x0 0x100000>;
			ranges = <0x02000000 0x0 0xfe000000  0x0 0xfe000000  0x0 0x01000000>;
			bus-range = <0x00 0x00>;
		};

		/* SoC GPIO (PL061), 6 banks × 8 = 48 lines. "arm,pl061" only (drop
		 * primecell -> no AMBA needed). gpio-line-names = the live MUIO
		 * pinmux map (read 2026-08-18, docs/gpio-map.md) so `gpio status`
		 * self-labels every ball: mux func 0=GPIO / nand / uart2(RPS) /
		 * sgpo / eth-led. "spare*" = GPIO-mode, no known consumer (SW1/SW2/
		 * strap candidates). NAND-bus lines named so they're not mistaken
		 * for free. */
		gpio0: gpio@fd887000 {
			compatible = "arm,pl061"; reg = <0x0 0xfd887000 0x0 0x1000>;
			gpio-controller; #gpio-cells = <2>;
			gpio-line-names = "sfp-25g-led", "spare1", "spare2", "spare3",
					  "spare4", "spare5", "nand-d0", "nand-d1";
		};
		gpio1: gpio@fd888000 {
			compatible = "arm,pl061"; reg = <0x0 0xfd888000 0x0 0x1000>;
			gpio-controller; #gpio-cells = <2>;
			gpio-line-names = "nand-d2", "nand-d3", "nand-d4", "nand-d5",
					  "nand-d6", "nand-d7", "nand-d8", "nand-d9";
		};
		gpio2: gpio@fd889000 {
			compatible = "arm,pl061"; reg = <0x0 0xfd889000 0x0 0x1000>;
			gpio-controller; #gpio-cells = <2>;
			gpio-line-names = "nand-d10", "nand-d11", "nand-d12", "nand-cs",
					  "spare20", "sgpo", "spare22", "spare23";
		};
		gpio5: gpio@fd897000 {
			compatible = "arm,pl061"; reg = <0x0 0xfd897000 0x0 0x1000>;
			gpio-controller; #gpio-cells = <2>;
			gpio-line-names = "spare40", "spare41", "hdd-force-pwr", "spare43",
					  "spare44", "spare45", "spare46", "spare47";
		};
		gpio3: gpio@fd88a000 {
			compatible = "arm,pl061";
			reg = <0x0 0xfd88a000 0x0 0x1000>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-line-names = "sgpo", "sgpo", "uart2-rps-rx", "uart2-rps-tx",
					  "spare28", "spare29", "eth-led", "ulogo-blue";
		};
		gpio4: gpio@fd88b000 {
			compatible = "arm,pl061";
			reg = <0x0 0xfd88b000 0x0 0x1000>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-line-names = "spare32", "rps-prnt", "12v-lp", "spare35",
					  "spare36", "ulogo-white", "reset-btn", "spare39";
		};

		/*
		 * I2C "i2c-pld" (DesignWare) @ fd880000, 100 kHz. Hosts the PCA9575
		 * GPIO expanders. We need @0x21 to POWER THE SATA BAYS before AHCI:
		 * on a warm reset the expander drops its outputs, so the drives are
		 * unpowered and every SATA link times out. Same hog the kernel DTS
		 * uses (bays 1-4 = lines 0-3, active-high). This is the "just power
		 * the drive" step — replicated from upstream, not invented.
		 */
		i2c@fd880000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0xfd880000 0x0 0x1000>;
			clocks = <&sbclk>;
			/* 400 kHz (Fast-mode) = rated max for THIS bus: PCA9575 alone
			 * does 1 MHz (Fm+) but the shared PCA9546 mux + AT24C64 cap at
			 * 400 kHz. Kernel runs 100 kHz (conservative); we run the max. */
			clock-frequency = <400000>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			/* @0x20 — SFP+ 1G link LED on pin 2 (see LED map). */
			i2c_gpio0: gpio@20 {
				compatible = "nxp,pca9575";
				reg = <0x20>;
				gpio-controller;
				#gpio-cells = <2>;
			};

			i2c_gpio1: gpio@21 {
				compatible = "nxp,pca9575";
				reg = <0x21>;
				gpio-controller;
				#gpio-cells = <2>;

				/* One hog per line — U-Boot's gpio-hog only takes the
				 * FIRST gpio in a list, so a single node with 4 gpios
				 * powered only bay 1. Bays 1-4 = lines 0-3, active-high. */
				hdd-pwren0-hog { gpio-hog; gpios = <0 0>; output-high; line-name = "hdd-pwren0"; };
				hdd-pwren1-hog { gpio-hog; gpios = <1 0>; output-high; line-name = "hdd-pwren1"; };
				hdd-pwren2-hog { gpio-hog; gpios = <2 0>; output-high; line-name = "hdd-pwren2"; };
				hdd-pwren3-hog { gpio-hog; gpios = <3 0>; output-high; line-name = "hdd-pwren3"; };
			};

			/* DDR-config EEPROM @0x57 (AT24C64, 16-bit addr). Reads
			 * 0x1c36-repeating — the DDR bootstrap blob (issue #67), not
			 * plain SPD. Node lets `i2c md` use the right 2-byte offset. */
			eeprom@57 {
				compatible = "atmel,24c64";
				reg = <0x57>;
				pagesize = <32>;
			};

			/* PCA9546 i2c mux @0x71 (present, probes) gates: ch0 -> s35390a
			 * RTC @0x30, ch3 -> adt7475 monitor @0x2e. NODE DELIBERATELY OMITTED
			 * from our U-Boot: every behind-mux access times out / hangs the DW
			 * bus (same regression Linux 7.1 hits — docs/i2c-map.md), and neither
			 * device is needed to boot. Left as a bare device (`i2c probe` sees
			 * 0x71) — do NOT add mux children until the behind-mux timeout is fixed. */
		};

		/* Second DW i2c "i2c-gen" @0xfd894000. Empty on ea16 (scanned live,
		 * no devices — docs/i2c-map.md) but enabled so `i2c dev 1; i2c probe`
		 * can confirm nothing hides here. Stock ea16 DTS marks it disabled;
		 * we keep it live for RE. clock via sbclk, same 400 kHz. */
		i2c@fd894000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0xfd894000 0x0 0x1000>;
			clocks = <&sbclk>;
			clock-frequency = <400000>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";
		};
	};

	/* Named LEDs -> the `led` command (led <label> on|off, led list). All
	 * default-on so a running our-U-Boot lights the panel. pca9575-backed only
	 * for now: SFP (@0x20 pin2) + bay1-4 fault (@0x21 lines12-15, orange).
	 * Logo (al_gpio) + bay activity (SGPO) LEDs need those driver ports. */
	leds {
		compatible = "gpio-leds";
		led-d1 { label = "d1"; gpios = <&i2c_gpio1 12 0>; default-state = "on"; };
		led-d2 { label = "d2"; gpios = <&i2c_gpio1 13 0>; default-state = "on"; };
		led-d3 { label = "d3"; gpios = <&i2c_gpio1 14 0>; default-state = "on"; };
		led-d4 { label = "d4"; gpios = <&i2c_gpio1 15 0>; default-state = "on"; };
		led-sfp { label = "sfp"; gpios = <&i2c_gpio0 2 1>; default-state = "on"; };
		led-white { label = "white"; gpios = <&gpio4 5 1>; default-state = "on"; };
		led-blue { label = "blue"; gpios = <&gpio3 7 1>; default-state = "on"; };
	};
};
