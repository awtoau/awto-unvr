#
# /init of the TrueNAS maint initramfs (scripts/truenas-install.py, #338). Booted ONCE via
# bootonce=truenas-maint (U-Boot already cleared it): any failure or reset -> Fedora.
# - Loads the SATA/ext4/squashfs/zfs modules, mounts p2 (by PARTUUID) rw.
# - Runs $JOB_DIR/job.py inside the TrueNAS live env (ISO filesystem.squashfs + tmpfs overlay).
# - Log: p2 $JOB_DIR/logs/<boot>.log. Then reboot (sysrq), SP805 reset as the fallback.
# - p2 writes stay under $JOB_DIR (/srv/truenas-install).

set -u
export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C
. /etc/tnmaint.conf

LOG=/run/tnmaint.log
now() { local up; read -r up _ </proc/uptime; echo "${up%.*}"; }
log() {
    echo "T+$(now)s $*" >>"$LOG"
    [ -c /dev/kmsg ] && echo "tnmaint: $*" >/dev/kmsg
}

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs -o mode=755 tmpfs /run
ln -s /proc/self/fd /dev/fd
log "start, kernel $(uname -r)"

# --- watchdog: feed while SSD I/O or the job's CPU time moves; STALL_S of neither = hung -> reset.
# (System-wide CPU would count the feeder itself.)
progress_sig() {
    local s="" pid f
    [ -r /run/wdt.disk ] && s="$(cat "/sys/block/$(cat /run/wdt.disk)/stat" 2>/dev/null)"
    pid=$(cat /run/wdt.pid 2>/dev/null)
    if [ -n "$pid" ] && read -r -a f 2>/dev/null <"/proc/$pid/stat"; then
        s="$s cpu=${f[13]}+${f[14]}+${f[15]}+${f[16]}"
    fi
    echo "$s"
}
feeder() {
    local sig last="" changed n
    changed=$(now)
    while :; do
        [ -e /run/wdt.stop ] && exit 0
        n=$(now)
        sig=$(progress_sig)
        if [ "$sig" != "$last" ]; then last=$sig; changed=$n; fi
        if ((n - changed > STALL_S)); then
            log "watchdog: no I/O or CPU progress for ${STALL_S}s - stop feeding"
            exit 0
        fi
        printf 1 >&3
        sleep "$FEED_EVERY_S"
    done
}

# netconsole drops what is logged before the 1G link is up: replay the record over it.
replay() {
    local l
    { cat "$LOG"; dmesg | tail -n 400; } | while IFS= read -r l; do echo "tnmaint-replay: $l" >/dev/kmsg; done
}

finish() {
    log "finish: $1"
    replay
    [ -c /dev/zfs ] && chroot /live zpool export -a >>"$LOG" 2>&1
    sync
    if [ -n "${P2LOG:-}" ]; then cat "$LOG" >"$P2LOG"; sync; fi
    umount -R /live 2>/dev/null
    umount /mnt/p2 2>/dev/null
    touch /run/wdt.stop
    echo b >/proc/sysrq-trigger
    # sysrq returned (no restart handler?): the stopped feeder lets SP805 reset in ~17 s.
    while :; do sleep 60; done
}

for m in $MODULES; do
    modprobe "$m" >>"$LOG" 2>&1 || log "modprobe $m failed"
done
if [ -c /dev/watchdog ] && exec 3>/dev/watchdog; then
    feeder &
    log "watchdog armed, stall ${STALL_S}s"
else
    log "no /dev/watchdog - running unguarded"
fi

# --- p2 by PARTUUID (SSD probe measured 4.7-21.6 s on this box: ssd-repartition.py T_DISK)
P2=""
lim=$(($(now) + T_DISK))
pci_list() { local d; for d in /sys/bus/pci/devices/*; do echo -n "${d##*/}=$(cat "$d/vendor"):$(cat "$d/device") "; done; }
log "pci: $(pci_list)"
rescanned=0
while [ -z "$P2" ] && (($(now) < lim)); do
    P2=$(blkid -t "PARTUUID=$P2_PARTUUID" -o device 2>/dev/null | head -n1)
    if [ -z "$P2" ] && [ "$rescanned" = 0 ] && (($(now) > lim - T_DISK / 2)); then
        # Diagnostics only: p2 still missing halfway through T_DISK - record why (#338).
        rescanned=1
        echo 1 >/sys/bus/pci/rescan
        log "pci after rescan: $(pci_list); block: $(ls /sys/block | tr '\n' ' ')"
        log "modules: $(grep -oE '^(ahci[a-z_]*|libahci|libata|sd_mod)' /proc/modules | tr '\n' ' ')"
        log "pci drivers: $(ls /sys/bus/pci/drivers | tr '\n' ' ')"
        for s in 0000:00:08.0 0000:00:09.0; do
            dp=/sys/bus/pci/devices/$s
            [ -d "$dp" ] || continue
            log "$s class=$(cat $dp/class) enable=$(cat $dp/enable) driver=$(readlink $dp/driver) override=$(cat $dp/driver_override 2>&1)"
            echo "$s" >/sys/bus/pci/drivers/ahci-alpine/bind 2>>"$LOG" || log "bind $s to ahci-alpine failed"
        done
        log "after bind: driver08=$(readlink /sys/bus/pci/devices/0000:00:08.0/driver) block: $(ls /sys/block | tr '\n' ' ')"
        mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
        log "deferred: $(tr '\n' '|' </sys/kernel/debug/devices_deferred 2>&1)"
        log "regulators: $(cat /sys/class/regulator/*/name 2>&1 | tr '\n' ' ')"
        log "reg-fixed bound: $(ls /sys/bus/platform/drivers/reg-fixed-voltage 2>&1 | tr '\n' ' ')"
        log "08 waiting_for_supplier=$(cat /sys/bus/pci/devices/0000:00:08.0/waiting_for_supplier 2>&1) links: $(ls /sys/bus/pci/devices/0000:00:08.0 | grep -E 'supplier|consumer' | tr '\n' ' ')"
        for l in /sys/class/devlink/*0000:00:08.0*; do log "devlink ${l##*/} status=$(cat $l/status 2>&1)"; done
        dmesg | tail -n 40 | while IFS= read -r l; do log "dmesg: $l"; done
    fi
    [ -n "$P2" ] || sleep 1
done
[ -n "$P2" ] || finish "p2 PARTUUID $P2_PARTUUID not found in ${T_DISK}s"
d=${P2#/dev/}
echo "${d%%[0-9]*}" >/run/wdt.disk
mkdir -p /mnt/p2
mount -t ext4 -o rw,noatime "$P2" /mnt/p2 || finish "mount $P2 failed"
J=/mnt/p2$JOB_DIR
mkdir -p "$J/logs"
P2LOG="$J/logs/maint-$(cat /proc/sys/kernel/random/boot_id).log"
log "p2 $P2 mounted; log -> $P2LOG"
cat "$LOG" >"$P2LOG"

# --- TrueNAS live env: ISO squashfs + tmpfs overlay; p2 bind-mounted at the same path
mkdir -p /live-ro /live-rw /live
mount -t squashfs -o ro,loop "$J/filesystem.squashfs" /live-ro || finish "live squashfs mount failed"
mount -t tmpfs -o size=1g tmpfs /live-rw
mkdir -p /live-rw/u /live-rw/w
mount -t overlay overlay -o lowerdir=/live-ro,upperdir=/live-rw/u,workdir=/live-rw/w /live ||
    finish "overlay mount failed"
for f in dev proc sys; do mount --rbind "/$f" "/live/$f"; done
mount -t tmpfs tmpfs /live/tmp
mount -t tmpfs tmpfs /live/run
mkdir -p /live/mnt/p2
mount --bind /mnt/p2 /live/mnt/p2

log "job: $JOB_DIR/job.py"
chroot /live /usr/bin/python3 -u "$J/job.py" "$J/job.json" </dev/null >>"$P2LOG.job" 2>&1 &
pid=$!
echo "$pid" >/run/wdt.pid
wait "$pid"
rc=$?
log "job rc=$rc (output: $P2LOG.job)"
finish "done rc=$rc"
