[Unit]
Description=Verify the running kernel matches its module tree's deploy provenance (#162)
Documentation=https://github.com/awtoau/awto-unvr/issues/162
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/check-kernel-module-match.py
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
