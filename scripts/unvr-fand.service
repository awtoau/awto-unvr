[Unit]
Description=UNVR fan control - off unless SoC >= 80 C (#44, #361, #373)
Documentation=https://github.com/awtoau/awto-unvr/issues/373
After=multi-user.target

[Service]
Type=simple
ExecStartPre=-/usr/sbin/modprobe drivetemp
ExecStart=/usr/local/bin/unvr-fand.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
