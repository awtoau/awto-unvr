[Unit]
Description=UNVR fan control - PWM from hottest of drives/SoC/board, never off (#44, #361, #373)
Documentation=https://github.com/awtoau/awto-unvr/issues/373
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/unvr-fand.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
