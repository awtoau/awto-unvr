 conf/build.manifest | 2 --
 1 file changed, 2 deletions(-)

diff --git a/conf/build.manifest b/conf/build.manifest
index 0742d58..bd6973c 100644
--- a/conf/build.manifest
+++ b/conf/build.manifest
@@ -602,8 +602,6 @@ sources:
         - truenas_pydiscovery
         - truenas_pyscstadmin
       subdir: src/middlewared
-    - name: middlewared-docs
-      subdir: src/middlewared_docs
     - name: truenas_files
       subdir: src/freenas
 - name: truenas_api_client
