From 208c1a5587b336ff932345bccac95396a636ab82 Mon Sep 17 00:00:00 2001
From: awto <noreply@awto.au>
Date: Sun, 15 Nov 2026 00:19:39 +1100
Subject: [PATCH 12/12] Build-dep install: --no-install-recommends

apt install ./*-build-deps.deb pulled Recommends of every build dep (-doc packages, python3-cryptography-vectors, ...), hundreds of unneeded packages unpacked per package build under qemu.
---
 scale_build/packages/build.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/scale_build/packages/build.py b/scale_build/packages/build.py
index 8834e52..d3b72a4 100644
--- a/scale_build/packages/build.py
+++ b/scale_build/packages/build.py
@@ -81,7 +81,7 @@ class BuildPackageMixin:
         self.execute_pre_depends_commands()
 
         self.run_in_chroot(f'cd {self.package_source} && mk-build-deps --build-dep', 'Failed mk-build-deps')
-        self.run_in_chroot(f'cd {self.package_source} && apt install -y ./*.deb', 'Failed install build deps')
+        self.run_in_chroot(f'cd {self.package_source} && apt install -y --no-install-recommends ./*.deb', 'Failed install build deps')
 
         # Truenas package is special
         if self.name == 'truenas':
