diff --git a/src/app/services/entitlements.service.ts b/src/app/services/entitlements.service.ts
index 6071600..84b8eef 100644
--- a/src/app/services/entitlements.service.ts
+++ b/src/app/services/entitlements.service.ts
@@ -1,9 +1,9 @@
 import {
-  Injectable, Injector, Signal, inject,
+  Injectable, Injector, Signal, inject, signal,
 } from '@angular/core';
 import { toSignal } from '@angular/core/rxjs-interop';
 import { MemoizedSelector, Store } from '@ngrx/store';
-import { Observable } from 'rxjs';
+import { Observable, of } from 'rxjs';
 import { filter } from 'rxjs/operators';
 import { EntitlementFeature } from 'app/enums/entitlement-feature.enum';
 import { EntitlementEntry } from 'app/interfaces/entitlement.interface';
@@ -12,6 +12,10 @@ import {
   selectEntitlement, selectIsEntitled, selectIsEntitledStrictly,
 } from 'app/store/entitlements/entitlements.selectors';
 
+// awto: community build, WebShare and TrueSearch are never gated (#357).
+const awtoOpenFeatures = new Set<EntitlementFeature>([EntitlementFeature.Webshare, EntitlementFeature.TrueSearch]);
+const awtoEntitled = signal<boolean | undefined>(true).asReadonly();
+
 /**
  * Reads middleware's entitlement decisions; never recomputes them.
  *
@@ -42,6 +46,9 @@ export class EntitlementsService {
   /** `undefined` while loading, deliberately not `false`. Check for it if a surface needs
    * to tell "loading" from "denied". */
   entitled(feature: EntitlementFeature): Signal<boolean | undefined> {
+    if (awtoOpenFeatures.has(feature)) {
+      return awtoEntitled;
+    }
     return this.cached(this.entitledSignals, feature, () => toSignal(
       this.store$.select(this.entitledSelector(feature)),
       { injector: this.injector },
@@ -54,6 +61,9 @@ export class EntitlementsService {
    * `selectIsEntitledStrictly` for when this is the right one to reach for.
    */
   entitledStrictly(feature: EntitlementFeature): Signal<boolean | undefined> {
+    if (awtoOpenFeatures.has(feature)) {
+      return awtoEntitled;
+    }
     return this.cached(this.strictSignals, feature, () => toSignal(
       this.store$.select(this.strictSelector(feature)),
       { injector: this.injector },
@@ -62,6 +72,9 @@ export class EntitlementsService {
 
   /** Emits nothing until the answer is real, so no consumer acts on a transient denial. */
   entitled$(feature: EntitlementFeature): Observable<boolean> {
+    if (awtoOpenFeatures.has(feature)) {
+      return of(true);
+    }
     return this.store$.select(this.entitledSelector(feature)).pipe(
       filter((entitled): entitled is boolean => entitled !== undefined),
     );
