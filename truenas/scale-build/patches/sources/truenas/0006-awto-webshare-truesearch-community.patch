From d811d4e1ab9af111fd07fc4698982914a5d07383 Mon Sep 17 00:00:00 2001
From: awto <noreply@awto.au>
Date: Sat, 14 Nov 2026 20:34:36 +1100
Subject: [PATCH] webshare/truesearch: no TNC start_blocker, no
 WEBSHARE/TRUESEARCH entitlement or index-dataset gate (awto-unvr #357)

- webshare.start_blocker returns None: awto-webshare serves its own TLS cert
- sharing.webshare validate skips truenas.entitlements.check(WEBSHARE)
- truesearch.unavailable_reasons returns []: awto truesearchd needs no index dataset or entitlement
- entitlement matrix/engine untouched
---
 .../middlewared/plugins/truesearch.py            | 16 +++-------------
 .../middlewared/plugins/webshare/config.py       | 15 ++-------------
 .../middlewared/plugins/webshare/sharing.py      | 11 +----------
 3 files changed, 6 insertions(+), 36 deletions(-)

diff --git a/src/middlewared/middlewared/plugins/truesearch.py b/src/middlewared/middlewared/plugins/truesearch.py
index 54d6de9..c26b5eb 100644
--- a/src/middlewared/middlewared/plugins/truesearch.py
+++ b/src/middlewared/middlewared/plugins/truesearch.py
@@ -10,7 +10,6 @@ import os
 import stat
 from typing import TYPE_CHECKING, Any, AsyncGenerator, Literal
 
-from truenas_pylicensed.features import LicenseFeature
 from truesearch_client import Busy, Client, Identity, NoIndex, OpenRequest, Refused, TruesearchError
 from truesearch_client import CallError as BoundError
 from truesearch_client.config import TARGETS_DIR, TargetRow, read_config, target_id
@@ -97,18 +96,9 @@ class TruesearchService(Service):
         """
         Returns a list of reasons why the truesearch service cannot be used.
         """
-        reasons = []
-
-        # The boot pool has no index dataset, because it cannot hold an encrypted dataset.
-        if await self.middleware.call('systemdataset.is_boot_pool'):
-            reasons.append('The system dataset must not reside on the boot pool.')
-        # setup_datasets leaves the index dataset unmounted when it cannot use the dataset.
-        elif not await self.middleware.run_in_thread(_index_dataset_mounted):
-            reasons.append('The TrueSearch index dataset is not mounted. The middleware log gives the reason.')
-
-        entitlement = await self.call2(self.s.truenas.entitlements.check, LicenseFeature.TRUESEARCH)
-        if not entitlement.entitled:
-            reasons.append(entitlement.message)
+        # awto-unvr: truesearchd keeps its index in /var/lib/truesearchd; no index dataset and no
+        # TRUESEARCH entitlement.
+        reasons: list[str] = []
 
         return reasons
 
diff --git a/src/middlewared/middlewared/plugins/webshare/config.py b/src/middlewared/middlewared/plugins/webshare/config.py
index a1b26d9..7e6542d 100644
--- a/src/middlewared/middlewared/plugins/webshare/config.py
+++ b/src/middlewared/middlewared/plugins/webshare/config.py
@@ -11,8 +11,6 @@ from middlewared.api.current import (
 )
 from middlewared.service import ConfigService, private, ValidationErrors
 import middlewared.sqlalchemy as sa
-from middlewared.plugins.truenas_connect.utils import CONFIGURED_TNC_STATES
-from middlewared.utils.hardware import get_hardware_class
 from middlewared.utils.webshare import WEBSHARE_BULK_DOWNLOAD_PATH, WEBSHARE_DATA_PATH, WEBSHARE_GROUP
 
 if TYPE_CHECKING:
@@ -163,17 +161,8 @@ class WebshareService(ConfigService[WebshareEntry]):
 
     @private
     async def start_blocker(self) -> str | None:
-        if (await self.middleware.run_in_thread(get_hardware_class)).is_appliance:
-            return None
-
-        tnc_config = await self.middleware.call('tn_connect.config')
-        if (
-            tnc_config['enabled'] and tnc_config['status'] in CONFIGURED_TNC_STATES
-            and tnc_config['certificate'] is not None
-        ):
-            return None
-
-        return 'Webshare requires TrueNAS Connect to be configured.'
+        # awto-unvr: no TrueNAS Connect requirement; awto-webshare serves its own certificate.
+        return None
 
 
 async def tn_connect_hostname_updated(middleware: Middleware) -> None:
diff --git a/src/middlewared/middlewared/plugins/webshare/sharing.py b/src/middlewared/middlewared/plugins/webshare/sharing.py
index 364506a..2790dd2 100644
--- a/src/middlewared/middlewared/plugins/webshare/sharing.py
+++ b/src/middlewared/middlewared/plugins/webshare/sharing.py
@@ -3,8 +3,6 @@ from __future__ import annotations
 import errno
 from typing import TYPE_CHECKING, Any, cast
 
-from truenas_pylicensed.features import LicenseFeature
-
 from middlewared.api import api_method
 from middlewared.api.current import (
     SharingWebshareEntry, SharingWebshareCreate, SharingWebshareCreateArgs, SharingWebshareCreateResult,
@@ -176,14 +174,7 @@ class SharingWebshareService(SharingService[SharingWebshareEntry]):
         verrors: ValidationErrors,
         old: SharingWebshareEntry | None = None,
     ) -> None:
-        # An update that leaves the share disabled is let through even without the entitlement,
-        # so a system that has lost it can still turn a share off instead of having to delete it.
-        # Everything else, creating a share included, stays gated.
-        if old is None or data.enabled:
-            entitlement = await self.call2(self.s.truenas.entitlements.check, LicenseFeature.WEBSHARE)
-            if not entitlement.entitled:
-                verrors.add(schema_name, entitlement.message)
-
+        # awto-unvr: no WEBSHARE entitlement check.
         await self.validate_share_name(data.name, schema_name, verrors, old)
 
         await self.validate_path_field(data, schema_name, verrors, split_path=True)
