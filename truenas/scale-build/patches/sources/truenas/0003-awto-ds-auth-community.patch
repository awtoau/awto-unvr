From 08fb6b3c68ae88d2399a702b5b185a2aecb88947 Mon Sep 17 00:00:00 2001
From: awto <noreply@awto.au>
Date: Sat, 14 Nov 2026 02:08:49 +1100
Subject: [PATCH 3/3] system.general: ds_auth without the
 DIRECTORY_SERVICES_AUTH entitlement (awto-unvr)

- only the ds_auth field validator changes; matrix/engine untouched
- consumers (pam.d/*.mako, pam_truenas) have no licence check
- LDAP/AD/IPA joins were never gated
---
 .../middlewared/plugins/system_general/update.py          | 8 +++-----
 1 file changed, 3 insertions(+), 5 deletions(-)

diff --git a/src/middlewared/middlewared/plugins/system_general/update.py b/src/middlewared/middlewared/plugins/system_general/update.py
index 585d0c8100..eba7e2f1e8 100644
--- a/src/middlewared/middlewared/plugins/system_general/update.py
+++ b/src/middlewared/middlewared/plugins/system_general/update.py
@@ -1,6 +1,5 @@
 import asyncio
 
-from truenas_pylicensed.features import LicenseFeature
 
 import middlewared.sqlalchemy as sa
 
@@ -100,10 +99,9 @@ class SystemGeneralService(ConfigService):
 
     @settings.fields_validator('ds_auth')
     async def _validate_ds_auth(self, verrors, ds_auth):
-        if ds_auth:
-            entitlement = await self.call2(self.s.truenas.entitlements.check, LicenseFeature.DIRECTORY_SERVICES_AUTH)
-            if not entitlement.entitled:
-                verrors.add('ds_auth', entitlement.message)
+        # awto-unvr: no DIRECTORY_SERVICES_AUTH entitlement check; the PAM stacks and
+        # pam_truenas that consume ds_auth are open source and carry no licence check.
+        return
 
     @settings.fields_validator('kbdmap')
     async def _validate_kbdmap(self, verrors, kbdmap):
