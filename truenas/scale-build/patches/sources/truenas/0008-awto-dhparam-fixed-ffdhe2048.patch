From: awto <noreply@awto.au>
Subject: [PATCH] dhparam_setup: fixed RFC 7919 ffdhe2048 group instead of generating (awto-unvr #369)

- `openssl dhparam 2048` takes ~6 min on a 4xA57; ix-etc (5 min limit) timed out, nginx failed.
---
diff --git a/src/middlewared/middlewared/plugins/crypto_/dhparams.py b/src/middlewared/middlewared/plugins/crypto_/dhparams.py
index 94a5d95..18382ca 100644
--- a/src/middlewared/middlewared/plugins/crypto_/dhparams.py
+++ b/src/middlewared/middlewared/plugins/crypto_/dhparams.py
@@ -21,8 +21,10 @@ class CertificateService(Service):
         """Generate dhparam.pem if it doesn't exist, or has no data in it"""
         with open(DHPARAM_PEM_PATH, 'a+') as f:
             if os.fstat(f.fileno()).st_size == 0:
+                # awto-unvr #369: fixed RFC 7919 ffdhe2048; `dhparam 2048` takes ~6 min on a 4xA57
                 subprocess.run(
-                    ['openssl', 'dhparam', '-out', DHPARAM_PEM_PATH, '-rand', '/dev/urandom', '2048'],
+                    ['openssl', 'genpkey', '-genparam', '-algorithm', 'DH', '-pkeyopt', 'group:ffdhe2048',
+                     '-out', DHPARAM_PEM_PATH],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True,
                 )
                 os.fchmod(f.fileno(), 0o600)
