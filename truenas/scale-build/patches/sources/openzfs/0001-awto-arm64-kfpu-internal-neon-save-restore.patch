@@ -62,23 +63,153 @@
 #define	ID_AA64PFR0_EL1		sys_reg(3, 0, 0, 1, 0)
 #define	ID_AA64ISAR0_EL1	sys_reg(3, 0, 0, 6, 0)
 
+#define	get_ftr(id) {				\
+	unsigned long __val;			\
+	asm("mrs %0, "#id : "=r" (__val));	\
+	__val;					\
+}
+
 #if (defined(HAVE_KERNEL_NEON) && defined(CONFIG_KERNEL_MODE_NEON))
 #define	kfpu_allowed()		1
 #define	kfpu_begin()		kernel_neon_begin()
 #define	kfpu_end()		kernel_neon_end()
+#define	kfpu_init()		(0)
+#define	kfpu_fini()		do {} while (0)
+#elif defined(HAVE_KERNEL_FPU_INTERNAL)
+/*
+ * kernel_neon_begin/end are GPL-only on arm64 (>= 6.2), so save/restore
+ * v0-v31 + FPSR/FPCR ourselves, as simd_x86.h does with XSAVE: preemption
+ * and IRQs off, per-CPU buffer, registers put back bit-identical.
+ */
+#include <linux/mm.h>
+#include <linux/slab.h>
+
+extern uint8_t **zfs_kfpu_fpregs;
+
+#define	KFPU_AARCH64_SIZE	(32 * 16 + 3 * 8)	/* q0-31, fpsr, fpcr, irq flags */
+
+/*
+ * Only the 128-bit V view is saved. With SVE/SME live state the upper Z
+ * bits would be lost, so refuse those CPUs (they get the generic code).
+ */
+static inline boolean_t
+kfpu_allowed(void)
+{
+	unsigned long sve = ((get_ftr(ID_AA64PFR0_EL1)) >> 32) & 0xf;
+	/* raw encoding: older binutils lack the ID_AA64PFR1_EL1 name */
+	unsigned long sme = ((get_ftr(S3_0_C0_C4_1)) >> 24) & 0xf;
+	return (sve == 0 && sme == 0);
+}
+
+static inline void
+kfpu_fini(void)
+{
+	int cpu;
+
+	if (zfs_kfpu_fpregs == NULL)
+		return;
+	for_each_possible_cpu(cpu) {
+		if (zfs_kfpu_fpregs[cpu] != NULL)
+			free_pages((unsigned long)zfs_kfpu_fpregs[cpu], 0);
+	}
+	kfree(zfs_kfpu_fpregs);
+	zfs_kfpu_fpregs = NULL;
+}
+
+static inline int
+kfpu_init(void)
+{
+	int cpu;
+
+	zfs_kfpu_fpregs = kzalloc(num_possible_cpus() * sizeof (uint8_t *),
+	    GFP_KERNEL);
+	if (zfs_kfpu_fpregs == NULL)
+		return (-ENOMEM);
+	for_each_possible_cpu(cpu) {
+		struct page *page = alloc_pages_node(cpu_to_node(cpu),
+		    GFP_KERNEL | __GFP_ZERO, 0);
+		if (page == NULL) {
+			kfpu_fini();
+			return (-ENOMEM);
+		}
+		zfs_kfpu_fpregs[cpu] = page_address(page);
+	}
+	return (0);
+}
+
+static inline void
+kfpu_begin(void)
+{
+	uint8_t *s;
+	uint64_t fpsr, fpcr;
+	unsigned long flags;
+
+	preempt_disable();
+	local_irq_save(flags);
+	s = zfs_kfpu_fpregs[smp_processor_id()];
+	__asm__ __volatile__(
+	    "stp q0,  q1,  [%0, #0]\n\t"
+	    "stp q2,  q3,  [%0, #32]\n\t"
+	    "stp q4,  q5,  [%0, #64]\n\t"
+	    "stp q6,  q7,  [%0, #96]\n\t"
+	    "stp q8,  q9,  [%0, #128]\n\t"
+	    "stp q10, q11, [%0, #160]\n\t"
+	    "stp q12, q13, [%0, #192]\n\t"
+	    "stp q14, q15, [%0, #224]\n\t"
+	    "stp q16, q17, [%0, #256]\n\t"
+	    "stp q18, q19, [%0, #288]\n\t"
+	    "stp q20, q21, [%0, #320]\n\t"
+	    "stp q22, q23, [%0, #352]\n\t"
+	    "stp q24, q25, [%0, #384]\n\t"
+	    "stp q26, q27, [%0, #416]\n\t"
+	    "stp q28, q29, [%0, #448]\n\t"
+	    "stp q30, q31, [%0, #480]\n\t"
+	    : : "r" (s) : "memory");
+	__asm__ __volatile__("mrs %0, fpsr\n\tmrs %1, fpcr"
+	    : "=r" (fpsr), "=r" (fpcr));
+	((uint64_t *)(s + 512))[0] = fpsr;
+	((uint64_t *)(s + 512))[1] = fpcr;
+	((unsigned long *)(s + 512))[2] = flags;
+}
+
+static inline void
+kfpu_end(void)
+{
+	uint8_t *s = zfs_kfpu_fpregs[smp_processor_id()];
+	uint64_t fpsr = ((uint64_t *)(s + 512))[0];
+	uint64_t fpcr = ((uint64_t *)(s + 512))[1];
+	unsigned long flags = ((unsigned long *)(s + 512))[2];
+
+	__asm__ __volatile__(
+	    "ldp q0,  q1,  [%0, #0]\n\t"
+	    "ldp q2,  q3,  [%0, #32]\n\t"
+	    "ldp q4,  q5,  [%0, #64]\n\t"
+	    "ldp q6,  q7,  [%0, #96]\n\t"
+	    "ldp q8,  q9,  [%0, #128]\n\t"
+	    "ldp q10, q11, [%0, #160]\n\t"
+	    "ldp q12, q13, [%0, #192]\n\t"
+	    "ldp q14, q15, [%0, #224]\n\t"
+	    "ldp q16, q17, [%0, #256]\n\t"
+	    "ldp q18, q19, [%0, #288]\n\t"
+	    "ldp q20, q21, [%0, #320]\n\t"
+	    "ldp q22, q23, [%0, #352]\n\t"
+	    "ldp q24, q25, [%0, #384]\n\t"
+	    "ldp q26, q27, [%0, #416]\n\t"
+	    "ldp q28, q29, [%0, #448]\n\t"
+	    "ldp q30, q31, [%0, #480]\n\t"
+	    "msr fpsr, %1\n\t"
+	    "msr fpcr, %2\n\t"
+	    : : "r" (s), "r" (fpsr), "r" (fpcr) : "memory");
+	local_irq_restore(flags);
+	preempt_enable();
+}
 #else
 #define	kfpu_allowed()		0
 #define	kfpu_begin()		do {} while (0)
 #define	kfpu_end()		do {} while (0)
-#endif
 #define	kfpu_init()		(0)
 #define	kfpu_fini()		do {} while (0)
-
-#define	get_ftr(id) {				\
-	unsigned long __val;			\
-	asm("mrs %0, "#id : "=r" (__val));	\
-	__val;					\
-}
+#endif
 
