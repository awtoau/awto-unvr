diff --git a/module/icp/algs/modes/gcm_pmull.c b/module/icp/algs/modes/gcm_pmull.c
new file mode 100644
index 0000000..f49fa72
--- /dev/null
+++ b/module/icp/algs/modes/gcm_pmull.c
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: CDDL-1.0 OR GPL-2.0-or-later
+/*
+ * Copyright (C) 2026 Awto / Daniel Tyrrell
+ *
+ * GHASH multiply via the ARMv8 PMULL instruction. Mirrors
+ * gcm_pclmulqdq.c; assembly in asm-aarch64/modes/ghashv8-armx.S
+ * (derived from OpenSSL).
+ */
+
+#if defined(__aarch64__)
+
+#include <sys/types.h>
+#include <sys/simd.h>
+#include <sys/asm_linkage.h>
+
+extern void ASMABI zfs_gcm_mul_pmull(const uint8_t *, const uint8_t *,
+    uint8_t *);
+
+#include <modes/gcm_impl.h>
+
+/*
+ * res = *x_in * *y in GF(2^128). All three are 16-byte blocks in GCM
+ * wire byte order, which is what the asm takes as-is (no byte swap).
+ */
+static void
+gcm_pmull_mul(uint64_t *x_in, uint64_t *y, uint64_t *res)
+{
+	kfpu_begin();
+	zfs_gcm_mul_pmull((const uint8_t *)x_in, (const uint8_t *)y,
+	    (uint8_t *)res);
+	kfpu_end();
+}
+
+static boolean_t
+gcm_pmull_will_work(void)
+{
+	return (kfpu_allowed() && zfs_pmull_available());
+}
+
+const gcm_impl_ops_t gcm_pmull_impl = {
+	.mul = &gcm_pmull_mul,
+	.is_supported = &gcm_pmull_will_work,
+	.name = "pmull"
+};
+
+#endif /* defined(__aarch64__) */
