diff --git a/module/icp/include/modes/simd_bulk.h b/module/icp/include/modes/simd_bulk.h
new file mode 100644
index 0000000..3bb5523
--- /dev/null
+++ b/module/icp/include/modes/simd_bulk.h
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: CDDL-1.0 OR GPL-2.0-or-later
+/*
+ * Copyright (C) 2026 Awto / Daniel Tyrrell
+ *
+ * Hold one kfpu section across a block loop instead of one per AES / GHASH
+ * block (aarch64 ARMv8 CE impls). kfpu_begin()/end() nest on aarch64, so the
+ * per-block sections inside the loop become counter bumps. The section is
+ * dropped every ICP_BULK_CHUNK bytes so IRQs are not held off for long.
+ */
+
+#ifndef	_MODES_SIMD_BULK_H
+#define	_MODES_SIMD_BULK_H
+
+#include <sys/simd.h>
+#include <aes/aes_impl.h>
+#include <modes/gcm_impl.h>
+#include <sys/crypto/common.h>
+
+#if defined(__aarch64__)
+
+#define	ICP_BULK_CHUNK	32768
+
+/*
+ * The "fastest" selection is a copy of the winning ops (aes_fastest_impl),
+ * so identify an impl by its function pointers, not its address.
+ */
+static inline boolean_t
+icp_is_aes_armv8(const void *keysched)
+{
+	return (((const aes_key_t *)keysched)->ops->encrypt ==
+	    aes_armv8_impl.encrypt);
+}
+
+/* keysched: aes_key_t *, gops: GCM impl in use or NULL (CCM) */
+static inline boolean_t
+icp_bulk_simd(const void *keysched, const gcm_impl_ops_t *gops)
+{
+	return (kfpu_allowed() && (icp_is_aes_armv8(keysched) ||
+	    (gops != NULL && gops->mul == gcm_pmull_impl.mul)));
+}
+
+/* bytes left in the output iovec the crypto_get_ptrs() cursor is in */
+static inline size_t
+icp_out_contig(crypto_data_t *out, void *iov_or_mp, offset_t offset)
+{
+	if (out->cd_format == CRYPTO_DATA_RAW) {
+		return (out->cd_raw.iov_len > (size_t)offset ?
+		    out->cd_raw.iov_len - offset : 0);
+	} else {
+		void *base;
+		uint64_t len;
+		uint_t idx = (uint_t)(uintptr_t)iov_or_mp;
+
+		if (idx >= zfs_uio_iovcnt(out->cd_uio))
+			return (0);
+		zfs_uio_iov_at_index(out->cd_uio, idx, &base, &len);
+		return (len > (uint64_t)offset ? len - offset : 0);
+	}
+}
+
+/* fused asm multi-block helpers usable: CE AES (+ PMULL for GCM) */
+#define	ICP_FUSED_MIN_BLOCKS	4
+
+static inline boolean_t
+icp_fused_gcm(const void *keysched)
+{
+	return (kfpu_allowed() && zfs_pmull_available() &&
+	    icp_is_aes_armv8(keysched));
+}
+
+static inline boolean_t
+icp_fused_ccm(const void *keysched)
+{
+	return (kfpu_allowed() && icp_is_aes_armv8(keysched));
+}
+
+#define	icp_bulk_begin(on)	do { if (on) kfpu_begin(); } while (0)
+#define	icp_bulk_end(on)	do { if (on) kfpu_end(); } while (0)
+/* `done`: bytes processed so far, a multiple of the block size */
+#define	icp_bulk_tick(on, done)						\
+	do {								\
+		if ((on) && ((done) % ICP_BULK_CHUNK) == 0) {		\
+			kfpu_end();					\
+			kfpu_begin();					\
+		}							\
+	} while (0)
+
+#else
+
+#define	icp_bulk_simd(keysched, gops)	(B_FALSE)
+#define	icp_fused_gcm(keysched)	(B_FALSE)
+#define	icp_fused_ccm(keysched)	(B_FALSE)
+#define	icp_out_contig(out, iov, off)	(0)
+#define	icp_bulk_begin(on)	do { (void) (on); } while (0)
+#define	icp_bulk_end(on)	do { (void) (on); } while (0)
+#define	icp_bulk_tick(on, done)	do { (void) (on); } while (0)
+
+#endif
+
+#endif	/* _MODES_SIMD_BULK_H */
