new file mode 100644
index 0000000..a401094
--- /dev/null
+++ b/module/icp/asm-aarch64/modes/ghashv8-armx.S
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: Apache-2.0
+/*
