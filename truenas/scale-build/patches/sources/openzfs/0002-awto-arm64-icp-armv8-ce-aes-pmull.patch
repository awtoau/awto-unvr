 }
 
+/*
+ * Streaming update, so it can be split anywhere: with the ARMv8 CE impl
+ * each ICP_BULK_CHUNK piece runs inside a single kfpu section.
+ */
+int
+ccm_mode_encrypt_contiguous_blocks(ccm_ctx_t *ctx, char *data, size_t length,
+    crypto_data_t *out, size_t block_size,
+    int (*encrypt_block)(const void *, const uint8_t *, uint8_t *),
+    void (*copy_block)(uint8_t *, uint8_t *),
+    void (*xor_block)(uint8_t *, uint8_t *))
+{
+#if defined(__aarch64__)
+	if (length > block_size && icp_bulk_simd(ctx->ccm_keysched, NULL)) {
+		int rv = CRYPTO_SUCCESS;
+
+		while (length > 0 && rv == CRYPTO_SUCCESS) {
+			size_t n = MIN(length, ICP_BULK_CHUNK);
+
+			kfpu_begin();
+			rv = ccm_mode_encrypt_contiguous_blocks_one(ctx, data,
+			    n, out, block_size, encrypt_block, copy_block,
+			    xor_block);
+			kfpu_end();
+			data += n;
+			length -= n;
+		}
+		return (rv);
+	}
+#endif
+	return (ccm_mode_encrypt_contiguous_blocks_one(ctx, data, length, out,
+	    block_size, encrypt_block, copy_block, xor_block));
+}
+
 void
