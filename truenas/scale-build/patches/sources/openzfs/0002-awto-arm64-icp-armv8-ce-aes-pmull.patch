+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+/*
+ * Portions Copyright (c) 2026 Awto / Daniel Tyrrell
+ * - modified assembly to fit into OpenZFS
+ */
+
+#if defined(__aarch64__)
+
+#define	AARCH64_VALID_CALL_TARGET	hint	34	/* bti c */
+
+.arch	armv8-a+crypto
+.text
+
+// void zfs_gcm_mul_pmull(const uint8_t x[16], const uint8_t h[16], uint8_t res[16])
+// res = x * h in GF(2^128), all three in GCM wire byte order.
+// OpenSSL gcm_init_v8() (twisted H, no H^2..H^4) fused with gcm_gmult_v8().
+.globl	zfs_gcm_mul_pmull
+.type	zfs_gcm_mul_pmull,%function
+.align	4
+zfs_gcm_mul_pmull:
+	AARCH64_VALID_CALL_TARGET
+	ld1	{v17.2d},[x1]		//load input H
+#ifndef __AARCH64EB__
+	rev64	v17.16b,v17.16b		//OpenSSL byte-swaps H as two u64 before gcm_init_v8
+#endif
+	movi	v19.16b,#0xe1
+	shl	v19.2d,v19.2d,#57		//0xc2.0
+	ext	v3.16b,v17.16b,v17.16b,#8
+	ushr	v18.2d,v19.2d,#63
+	dup	v17.4s,v17.s[1]
+	ext	v16.16b,v18.16b,v19.16b,#8		//t0=0xc2....01
+	ushr	v18.2d,v3.2d,#63
+	sshr	v17.4s,v17.4s,#31		//broadcast carry bit
+	and	v18.16b,v18.16b,v16.16b
+	shl	v3.2d,v3.2d,#1
+	ext	v18.16b,v18.16b,v18.16b,#8
+	and	v16.16b,v16.16b,v17.16b
+	orr	v3.16b,v3.16b,v18.16b		//H<<<=1
+	eor	v20.16b,v3.16b,v16.16b		//twisted H
+	ext	v21.16b,v20.16b,v20.16b,#8	//Karatsuba pre-processing
+	eor	v21.16b,v21.16b,v20.16b
+
+	ld1	{v17.2d},[x0]		//load Xi
+#ifndef __AARCH64EB__
+	rev64	v17.16b,v17.16b
+#endif
+	ext	v3.16b,v17.16b,v17.16b,#8
+
+	pmull	v0.1q,v20.1d,v3.1d		//H.lo*Xi.lo
+	eor	v17.16b,v17.16b,v3.16b		//Karatsuba pre-processing
+	pmull2	v2.1q,v20.2d,v3.2d		//H.hi*Xi.hi
+	pmull	v1.1q,v21.1d,v17.1d		//(H.lo+H.hi)*(Xi.lo+Xi.hi)
+
+	ext	v17.16b,v0.16b,v2.16b,#8		//Karatsuba post-processing
+	eor	v18.16b,v0.16b,v2.16b
+	eor	v1.16b,v1.16b,v17.16b
+	eor	v1.16b,v1.16b,v18.16b
+	pmull	v18.1q,v0.1d,v19.1d		//1st phase of reduction
+
+	ins	v2.d[0],v1.d[1]
+	ins	v1.d[1],v0.d[0]
+	eor	v0.16b,v1.16b,v18.16b
+
+	ext	v18.16b,v0.16b,v0.16b,#8		//2nd phase of reduction
+	pmull	v0.1q,v0.1d,v19.1d
+	eor	v18.16b,v18.16b,v2.16b
+	eor	v0.16b,v0.16b,v18.16b
+
+#ifndef __AARCH64EB__
+	rev64	v0.16b,v0.16b
+#endif
+	ext	v0.16b,v0.16b,v0.16b,#8
+	st1	{v0.2d},[x2]		//write out result
+
+	ret
+.size	zfs_gcm_mul_pmull,.-zfs_gcm_mul_pmull
+
+#endif /* __aarch64__ */
