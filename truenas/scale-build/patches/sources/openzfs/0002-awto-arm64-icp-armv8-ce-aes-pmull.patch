diff --git a/module/icp/algs/aes/aes_impl_armv8.c b/module/icp/algs/aes/aes_impl_armv8.c
new file mode 100644
index 0000000..f0788f1
--- /dev/null
+++ b/module/icp/algs/aes/aes_impl_armv8.c
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: CDDL-1.0 OR GPL-2.0-or-later
+/*
+ * Copyright (C) 2026 Awto / Daniel Tyrrell
+ *
+ * AES via the ARMv8 Crypto Extension, one block per call.
+ * Mirrors aes_impl_aesni.c; assembly in asm-aarch64/aes/aesv8-armx.S
+ * (derived from OpenSSL).
+ */
+
+#if defined(__aarch64__)
+
+#include <sys/simd.h>
+#include <sys/types.h>
+#include <sys/asm_linkage.h>
+
+extern ASMABI int zfs_aes_v8_set_encrypt_key(const uint8_t *userKey,
+	const int bits, uint32_t *rk_and_rounds);
+extern ASMABI int zfs_aes_v8_set_decrypt_key(const uint8_t *userKey,
+	const int bits, uint32_t *rk_and_rounds);
+extern ASMABI void zfs_aes_v8_encrypt(const uint32_t rk[], int Nr,
+	const uint32_t pt[4], uint32_t ct[4]);
+extern ASMABI void zfs_aes_v8_decrypt(const uint32_t rk[], int Nr,
+	const uint32_t ct[4], uint32_t pt[4]);
+
+#include <aes/aes_impl.h>
+
+/* the asm stores the round count in the word after the 60-word schedule */
+#define	AES_V8_KS_WORDS		(((MAX_AES_NR) + 1) * (MAX_AES_NB))
+
+extern ASMABI void zfs_aes_v8_ctr32_encrypt_blocks(const uint8_t *in,
+	uint8_t *out, size_t blocks, const uint32_t rk[], const uint8_t *iv,
+	int nr);
+extern ASMABI void zfs_aes_v8_cbcmac(uint8_t *mac, const uint8_t *in,
+	size_t blocks, const uint32_t rk[], int nr);
+extern ASMABI void zfs_gcm_init_v8(uint64_t htable[24], const uint8_t *h);
+extern ASMABI void zfs_gcm_ghash_v8(uint8_t *xi, const uint64_t htable[24],
+	const uint8_t *in, size_t len);
+
+static void
+aes_armv8_generate(aes_key_t *key, const uint32_t *keyarr32, int keybits)
+{
+	uint32_t enc[AES_V8_KS_WORDS + 4];
+	uint32_t dec[AES_V8_KS_WORDS + 4];
+	int nr;
+
+	kfpu_begin();
+	nr = zfs_aes_v8_set_encrypt_key((const uint8_t *)keyarr32, keybits,
+	    enc);
+	ASSERT0(nr);
+	(void) nr;
+	(void) zfs_aes_v8_set_decrypt_key((const uint8_t *)keyarr32, keybits,
+	    dec);
+	kfpu_end();
+
+	memcpy(&key->encr_ks.ks32[0], enc, sizeof (key->encr_ks.ks32));
+	memcpy(&key->decr_ks.ks32[0], dec, sizeof (key->decr_ks.ks32));
+	key->nr = (keybits >> 5) + 6;
+}
+
+static void
+aes_armv8_encrypt(const uint32_t rk[], int Nr, const uint32_t pt[4],
+    uint32_t ct[4])
+{
+	kfpu_begin();
+	zfs_aes_v8_encrypt(rk, Nr, pt, ct);
+	kfpu_end();
+}
+
+static void
+aes_armv8_decrypt(const uint32_t rk[], int Nr, const uint32_t ct[4],
+    uint32_t pt[4])
+{
+	kfpu_begin();
+	zfs_aes_v8_decrypt(rk, Nr, ct, pt);
+	kfpu_end();
+}
+
+static boolean_t
+aes_armv8_will_work(void)
+{
+	return (kfpu_allowed() && zfs_aes_available());
+}
+
+const aes_impl_ops_t aes_armv8_impl = {
+	.generate = &aes_armv8_generate,
+	.encrypt = &aes_armv8_encrypt,
+	.decrypt = &aes_armv8_decrypt,
+	.is_supported = &aes_armv8_will_work,
+	.needs_byteswap = B_FALSE,
+	.name = "armv8"
+};
+
+#ifndef _KERNEL
+/* userland KAT only: proves the multi-block helpers ran */
+uint64_t aes_armv8_fused_calls;
+#define	FUSED_COUNT()	(aes_armv8_fused_calls++)
+#else
+#define	FUSED_COUNT()	((void) 0)
+#endif
+
+/*
+ * Multi-block helpers for the GCM / CCM mode loops. Callers hold a kfpu
+ * section (the begin/end here nest) and pass block counts of >= 1.
+ * `key` was expanded by this impl; iv is the counter block of the FIRST block.
+ */
+
+/* GCM: ghash over the blocks in `data` (ciphertext) */
+static void
+gcm_armv8_ghash(uint8_t *ghash, const uint8_t *h, const uint8_t *data,
+    size_t nblocks)
+{
+	uint64_t htab[24];
+
+	zfs_gcm_init_v8(htab, h);
+	zfs_gcm_ghash_v8(ghash, htab, data, nblocks * AES_BLOCK_LEN);
+}
+
+void
+aes_armv8_ctr_blocks(const aes_key_t *key, const uint8_t *iv,
+    const uint8_t *in, uint8_t *out, size_t nblocks)
+{
+	FUSED_COUNT();
+	kfpu_begin();
+	zfs_aes_v8_ctr32_encrypt_blocks(in, out, nblocks,
+	    &key->encr_ks.ks32[0], iv, key->nr);
+	kfpu_end();
+}
+
+/* encrypt: CTR in -> out, then GHASH the ciphertext (out) */
+void
+aes_armv8_gcm_encrypt_blocks(const aes_key_t *key, const uint8_t *iv,
+    uint8_t *ghash, const uint8_t *h, const uint8_t *in, uint8_t *out,
+    size_t nblocks)
+{
+	FUSED_COUNT();
+	kfpu_begin();
+	zfs_aes_v8_ctr32_encrypt_blocks(in, out, nblocks,
+	    &key->encr_ks.ks32[0], iv, key->nr);
+	gcm_armv8_ghash(ghash, h, out, nblocks);
+	kfpu_end();
+}
+
+/* decrypt in place: GHASH the ciphertext, then CTR */
+void
+aes_armv8_gcm_decrypt_blocks(const aes_key_t *key, const uint8_t *iv,
+    uint8_t *ghash, const uint8_t *h, uint8_t *data, size_t nblocks)
+{
+	FUSED_COUNT();
+	kfpu_begin();
+	gcm_armv8_ghash(ghash, h, data, nblocks);
+	zfs_aes_v8_ctr32_encrypt_blocks(data, data, nblocks,
+	    &key->encr_ks.ks32[0], iv, key->nr);
+	kfpu_end();
+}
+
+void
+aes_armv8_cbcmac_blocks(const aes_key_t *key, uint8_t *mac,
+    const uint8_t *in, size_t nblocks)
+{
+	FUSED_COUNT();
+	kfpu_begin();
+	zfs_aes_v8_cbcmac(mac, in, nblocks, &key->encr_ks.ks32[0], key->nr);
+	kfpu_end();
+}
+
+#endif /* defined(__aarch64__) */
