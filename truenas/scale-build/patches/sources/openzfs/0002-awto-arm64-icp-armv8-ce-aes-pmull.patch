+
+	ret
+.size	zfs_gcm_ghash_v8,.-zfs_gcm_ghash_v8
+.type	zfs_gcm_ghash_v8_4x,%function
+.align	4
+zfs_gcm_ghash_v8_4x:
+.Lzfs_gcm_ghash_v8_4x:
