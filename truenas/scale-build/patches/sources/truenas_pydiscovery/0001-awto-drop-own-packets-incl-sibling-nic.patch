From: awto <noreply@awto.au>
Subject: [PATCH] Drop our own mDNS/NBNS packets, incl. a sibling NIC on the same subnet (awto-unvr #367)

- Two NICs on one segment hear each other's probes with different A/AAAA rdata and read it as a peer name conflict.
- Each rename retry costs ~7 s; 20 renames = ~3 min, and a reload waits for startup to finish.
- Local-source check generalises the existing single-IP echo check (avahi does the same).
---
diff --git a/src/truenas_pydiscovery_utils/local_addr.py b/src/truenas_pydiscovery_utils/local_addr.py
new file mode 100644
index 0000000..2b8b384
--- /dev/null
+++ b/src/truenas_pydiscovery_utils/local_addr.py
@@ -0,0 +1,24 @@
+"""True if an address belongs to this host (any interface)."""
+from __future__ import annotations
+
+import socket
+
+
+def is_local_address(addr: tuple) -> bool:
+    """*addr* is a ``recvfrom`` source tuple (v4: ip, port; v6: ip, port, flow, scope).
+
+    A socket can only bind a non-wildcard address the host owns, so a
+    successful bind(ip, 0) means the packet came from this host - e.g. a
+    sibling NIC on the same subnet echoing our own multicast.
+    """
+    ip = addr[0]
+    try:
+        if ":" in ip:
+            family, target = socket.AF_INET6, (ip.split("%")[0], 0, 0, addr[3] if len(addr) > 3 else 0)
+        else:
+            family, target = socket.AF_INET, (ip, 0)
+        with socket.socket(family, socket.SOCK_DGRAM) as s:
+            s.bind(target)
+        return True
+    except (OSError, ValueError):
+        return False
diff --git a/src/truenas_pymdns/server/net/transport.py b/src/truenas_pymdns/server/net/transport.py
index a60b02e..df63560 100644
--- a/src/truenas_pymdns/server/net/transport.py
+++ b/src/truenas_pymdns/server/net/transport.py
@@ -16,6 +16,7 @@ from truenas_pymdns.protocol.constants import (
     MDNS_TTL,
 )
 from truenas_pymdns.protocol.message import MDNSMessage
+from truenas_pydiscovery_utils.local_addr import is_local_address
 from .multicast import (
     IP_RECVTTL,
     create_v4_socket,
@@ -197,6 +198,11 @@ class MDNSTransport:
         except (OSError, BlockingIOError):
             return
 
+        # Drop our own packets, incl. a sibling NIC's on the same segment: they
+        # carry different A/AAAA rdata and read as a peer name conflict.
+        if addr[1] == MDNS_PORT and is_local_address(addr):
+            return
+
         try:
             message = MDNSMessage.from_wire(data)
         except (ValueError, IndexError) as e:
