[Unit]
Description=truesearchd (Spotlight filename search for Samba)
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/truesearchd serve
RuntimeDirectory=truesearchd
StateDirectory=truesearchd
# Nothing to re-read (targets self-register). A HUP before Python installs its handler killed
# the daemon "cleanly", so Restart=on-failure never brought it back.
ExecReload=/bin/true
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
