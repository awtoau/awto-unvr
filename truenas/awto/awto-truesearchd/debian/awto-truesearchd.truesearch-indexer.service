[Unit]
Description=truesearch-indexer (periodic rescan of searched shares)
After=truesearchd.service

[Service]
Type=simple
ExecStart=/usr/bin/truesearchd index
StateDirectory=truesearchd
# Same as truesearchd.service: nothing to re-read; an early HUP would kill it cleanly.
ExecReload=/bin/true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
